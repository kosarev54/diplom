<UserControl x:Class="DispatcherARM.UI.Views.Pages.DriversPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Loaded="DriversPage_Loaded">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <TextBlock Text="Водители" Style="{StaticResource MaterialDesignHeadline5TextBlock}" />
            <Button Content="+ Добавить" Click="AddDriver_Click"
                    DockPanel.Dock="Right" HorizontalAlignment="Right"
                    Style="{StaticResource MaterialDesignRaisedButton}" materialDesign:ButtonAssist.CornerRadius="4" />
            <Button Content="✏️ Редактировать" Click="EditDriver_Click"
                    DockPanel.Dock="Right" HorizontalAlignment="Right"
                    Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0" />
            <Button Content="🗑 Удалить" Click="DeleteDriver_Click"
                    DockPanel.Dock="Right" HorizontalAlignment="Right"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Foreground="#E53935" BorderBrush="#E53935"
                    Margin="0,0,8,0" />
            <Button Content="💰 Расчёт зарплаты" Click="PaymentCalc_Click"
                    DockPanel.Dock="Right" HorizontalAlignment="Right"
                    Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0" />
        </DockPanel>

        <!-- Подсказка -->
        <TextBlock Grid.Row="1" Text="💡 Двойной клик по строке — открыть карточку водителя"
                   Foreground="Gray" FontSize="11" Margin="0,0,0,8" />

        <DataGrid x:Name="DriversGrid" Grid.Row="2"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  materialDesign:DataGridAssist.CellPadding="8 4" HeadersVisibility="Column"
                  MouseDoubleClick="DriversGrid_DoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*" />
                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="140" />
                <DataGridTextColumn Header="График" Binding="{Binding WorkSchedule}" Width="80" />
                <DataGridTextColumn Header="ВУ" Binding="{Binding LicenseNumber}" Width="110" />
                <DataGridTextColumn Header="Оклад (₽)" Binding="{Binding BaseSalary, StringFormat=N0}" Width="100" />
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100" />
                <DataGridTextColumn Header="ТС" Binding="{Binding AssignedVehicle.LicensePlate}" Width="90" />
            </DataGrid.Columns>
            <!-- Стиль строки — подсветка при наведении -->
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Cursor" Value="Hand" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
    </Grid>
</UserControl>
