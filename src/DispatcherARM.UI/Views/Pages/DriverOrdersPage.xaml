<UserControl x:Class="DispatcherARM.UI.Views.Pages.DriverOrdersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Loaded="Page_Loaded">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Заказы" Style="{StaticResource MaterialDesignHeadline5TextBlock}"/>
            <Button Content="🔄 Обновить" Click="Refresh_Click"
                    DockPanel.Dock="Right"
                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
        </DockPanel>

        <!-- Карточка водителя: имя + баланс -->
        <Border Grid.Row="1" Background="#EFF6FF" CornerRadius="10"
                Padding="16,12" Margin="0,0,0,10"
                BorderBrush="#BFDBFE" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <materialDesign:PackIcon Kind="AccountCircle" Width="36" Height="36"
                                         Foreground="#3F51B5" VerticalAlignment="Center"
                                         Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="DriverGreeting" FontWeight="Bold" FontSize="15"
                               Foreground="#1E3A5F"/>
                    <TextBlock x:Name="DriverStatusInfo" Foreground="#4B5563"
                               FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
                <!-- Баланс -->
                <Border Grid.Column="2" Background="#3F51B5" CornerRadius="8"
                        Padding="14,8">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="BalanceText" Foreground="White"
                                   FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Баланс" Foreground="#C5CAE9"
                                   FontSize="10" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Вкладки -->
        <TabControl Grid.Row="2" Style="{StaticResource MaterialDesignTabControl}">

            <!-- ══ ДОСТУПНЫЕ ЗАКАЗЫ (назначены диспетчером, ещё не приняты) ══ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📦 Доступные заказы"/>
                        <Border x:Name="AvailableBadge" Background="#EF4444" CornerRadius="8"
                                Padding="5,1" Margin="6,0,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="AvailableCount" Foreground="White"
                                       FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Background="#FFFBEB" CornerRadius="6" Padding="12,8"
                            Margin="0,6,0,8" BorderBrush="#FDE68A" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18"
                                                     Foreground="#D97706" VerticalAlignment="Center"
                                                     Margin="0,0,8,0"/>
                            <TextBlock Foreground="#92400E" FontSize="12"
                                       Text="Диспетчер назначил вам эти заказы. Нажмите «Взять заказ» чтобы принять в работу."/>
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="AvailableGrid" Grid.Row="1"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" SelectionMode="Single"
                              SelectionChanged="Available_SelectionChanged"
                              materialDesign:DataGridAssist.CellPadding="8 5"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№"        Binding="{Binding OrderNumber}" Width="90"/>
                            <DataGridTextColumn Header="Клиент"   Binding="{Binding ClientName}"  Width="150"/>
                            <DataGridTextColumn Header="Адрес"    Binding="{Binding Address}"     Width="*"/>
                            <DataGridTextColumn Header="Вес (кг)" Binding="{Binding Weight, StringFormat=F0}" Width="70"/>
                            <DataGridTextColumn Header="Приоритет" Binding="{Binding PriorityDisplay}" Width="100"/>
                            <DataGridTextColumn Header="Дата доставки" Binding="{Binding DeliveryDate, StringFormat=dd.MM.yyyy}" Width="110"/>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                                <Setter Property="Background" Value="#FFFDE7"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Priority}" Value="Urgent">
                                        <Setter Property="Background" Value="#FEE2E2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>

                    <!-- Нижняя панель -->
                    <Border Grid.Row="2" Background="White"
                            BorderBrush="#E8EAF0" BorderThickness="0,1,0,0" Padding="12,10">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="TakeOrderBtn" Content="✋ Взять заказ"
                                    Click="TakeOrder_Click" IsEnabled="False"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="#1565C0" Foreground="White"
                                    materialDesign:ButtonAssist.CornerRadius="6"
                                    Margin="0,0,8,0" Padding="20,0" Height="36"/>
                            <TextBlock x:Name="AvailableHint" VerticalAlignment="Center"
                                       Foreground="Gray" FontSize="12"
                                       Text="Выберите заказ и нажмите «Взять заказ»"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ══ МОИ ЗАКАЗЫ (принятые в работу) ══ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🚗 Мои заказы"/>
                        <Border x:Name="MyOrdersBadge" Background="#3F51B5" CornerRadius="8"
                                Padding="5,1" Margin="6,0,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="MyOrdersCount" Foreground="White"
                                       FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Background="#F0FDF4" CornerRadius="6" Padding="12,8"
                            Margin="0,6,0,8" BorderBrush="#BBF7D0" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TruckDelivery" Width="18" Height="18"
                                                     Foreground="#166534" VerticalAlignment="Center"
                                                     Margin="0,0,8,0"/>
                            <TextBlock Foreground="#166534" FontSize="12"
                                       Text="Ваши активные заказы. После доставки отметьте выполнение — администратор подтвердит и начислит оплату."/>
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="MyOrdersGrid" Grid.Row="1"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" SelectionMode="Single"
                              SelectionChanged="MyOrders_SelectionChanged"
                              materialDesign:DataGridAssist.CellPadding="8 5"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№"        Binding="{Binding OrderNumber}" Width="90"/>
                            <DataGridTextColumn Header="Клиент"   Binding="{Binding ClientName}"  Width="150"/>
                            <DataGridTextColumn Header="Адрес"    Binding="{Binding Address}"     Width="*"/>
                            <DataGridTextColumn Header="Вес (кг)" Binding="{Binding Weight, StringFormat=F0}" Width="70"/>
                            <DataGridTextColumn Header="Статус"   Binding="{Binding StatusDisplay}" Width="200"/>
                            <DataGridTextColumn Header="До"       Binding="{Binding DeliveryDate, StringFormat=dd.MM.yyyy}" Width="90"/>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWaitingConfirm}" Value="True">
                                        <Setter Property="Background" Value="#FFF3E0"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsWaitingConfirm}" Value="False">
                                        <Setter Property="Background" Value="#E3F2FD"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>

                    <!-- Нижняя панель -->
                    <Border Grid.Row="2" Background="White"
                            BorderBrush="#E8EAF0" BorderThickness="0,1,0,0" Padding="12,10">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="CompleteBtn" Content="✅ Отметить выполненным"
                                    Click="MarkComplete_Click" IsEnabled="False"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="#2E7D32" Foreground="White"
                                    materialDesign:ButtonAssist.CornerRadius="6"
                                    Margin="0,0,8,0" Padding="20,0" Height="36"/>
                            <TextBlock x:Name="MyOrdersHint" VerticalAlignment="Center"
                                       Foreground="Gray" FontSize="12"
                                       Text="Выберите активный заказ для отметки выполнения"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ══ ИСТОРИЯ (подтверждённые и оплаченные) ══ -->
            <TabItem Header="✅ История выплат">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="#F0FDF4" CornerRadius="6" Padding="12,8"
                            Margin="0,6,0,8" BorderBrush="#BBF7D0" BorderThickness="1">
                        <TextBlock Foreground="#166534" FontSize="12"
                                   Text="Заказы, подтверждённые администратором. Средства уже зачислены на ваш баланс."/>
                    </Border>

                    <DataGrid x:Name="HistoryGrid" Grid.Row="1"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False"
                              materialDesign:DataGridAssist.CellPadding="8 5"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№"          Binding="{Binding OrderNumber}" Width="90"/>
                            <DataGridTextColumn Header="Клиент"     Binding="{Binding ClientName}"  Width="150"/>
                            <DataGridTextColumn Header="Адрес"      Binding="{Binding Address}"     Width="*"/>
                            <DataGridTextColumn Header="Цена (₽)"   Binding="{Binding DeliveryPrice, StringFormat=N0}" Width="90"/>
                            <DataGridTextColumn Header="Выполнен"   Binding="{Binding CompletedAt, StringFormat=dd.MM.yyyy}" Width="100"/>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                                <Setter Property="Background" Value="#F1F8E9"/>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
