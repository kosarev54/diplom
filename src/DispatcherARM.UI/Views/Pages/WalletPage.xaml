<UserControl x:Class="DispatcherARM.UI.Views.Pages.WalletPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Loaded="WalletPage_Loaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Шапка с балансом -->
        <materialDesign:ColorZone Mode="PrimaryMid" CornerRadius="8" Padding="24,16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="💰 Мой кошелёк" Foreground="White"
                               Style="{StaticResource MaterialDesignHeadline6TextBlock}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <StackPanel Margin="0,0,32,0">
                            <TextBlock x:Name="BalanceText" Text="0,00 ₽"
                                       Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                                       Foreground="White" FontWeight="Bold" />
                            <TextBlock Text="Доступно" Foreground="#B0BEC5" FontSize="12" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock x:Name="PendingText" Text="0,00 ₽"
                                       Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                                       Foreground="#FFF9C4" />
                            <TextBlock Text="Ожидает подтверждения" Foreground="#B0BEC5" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Content="💳 Вывести на карту" Click="Withdraw_Click"
                            Style="{StaticResource MaterialDesignRaisedLightButton}"
                            Margin="0,0,0,8" />
                    <TextBlock x:Name="CardText" Text="Карта не привязана"
                               Foreground="#B0BEC5" FontSize="11" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </materialDesign:ColorZone>

        <!-- Статистика -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <Border Background="#E8F5E9" CornerRadius="8" Padding="16,10" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock x:Name="TotalEarnedText" Text="0 ₽"
                               Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                               Foreground="#2E7D32" HorizontalAlignment="Center" />
                    <TextBlock Text="Всего заработано" Foreground="Gray" FontSize="11" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border Background="#FCE4EC" CornerRadius="8" Padding="16,10" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock x:Name="TotalWithdrawnText" Text="0 ₽"
                               Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                               Foreground="#C62828" HorizontalAlignment="Center" />
                    <TextBlock Text="Всего выведено" Foreground="Gray" FontSize="11" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border Background="#E3F2FD" CornerRadius="8" Padding="16,10">
                <StackPanel>
                    <TextBlock x:Name="MonthEarnedText" Text="0 ₽"
                               Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                               Foreground="{DynamicResource PrimaryHueMidBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="В этом месяце" Foreground="Gray" FontSize="11" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- История транзакций -->
        <GroupBox Grid.Row="2" Header="История операций"
                  Style="{StaticResource MaterialDesignCardGroupBox}">
            <DataGrid x:Name="TransactionsGrid"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      materialDesign:DataGridAssist.CellPadding="8 6" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}" Width="130" />
                    <DataGridTextColumn Header="Тип" Binding="{Binding TypeDisplay}" Width="110" />
                    <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*" />
                    <DataGridTextColumn Header="Сумма (₽)" Binding="{Binding AmountDisplay}" Width="100" />
                    <DataGridTextColumn Header="Статус" Binding="{Binding StatusDisplay}" Width="100" />
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEarning}" Value="True">
                                <Setter Property="Background" Value="#F1F8E9" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsWithdrawal}" Value="True">
                                <Setter Property="Background" Value="#FFEBEE" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </GroupBox>
    </Grid>
</UserControl>
