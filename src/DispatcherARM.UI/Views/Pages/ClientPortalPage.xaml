<UserControl x:Class="DispatcherARM.UI.Views.Pages.ClientPortalPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Background="#3F51B5" Padding="16,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="StartBtn" Content="▶ Запустить сервер" Click="StartServer_Click"
                            Background="#2E7D32" Foreground="White" BorderThickness="0"
                            Padding="14,6" Margin="0,0,8,0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="StopBtn" Content="⏹ Остановить" Click="StopServer_Click"
                            Background="#FFFFFF30" Foreground="White" BorderThickness="0"
                            IsEnabled="False" Padding="14,6" Margin="0,0,8,0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="🔄 Обновить заказы" Click="RefreshOrders_Click"
                            Background="#FFFFFF20" Foreground="White" BorderThickness="0"
                            Padding="14,6" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="👤 Клиентский портал — Приём заявок"
                               Foreground="White" FontSize="16" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#EF4444"
                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="StatusText"
                                   Foreground="#C5CAE9" FontSize="12"
                                   Text="Сервер не запущен — нажмите «Запустить»"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Панель последних заявок -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E8EAF0" BorderThickness="0,0,0,1" Padding="16,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📦 Последние веб-заявки:" VerticalAlignment="Center"
                           FontWeight="SemiBold" Margin="0,0,12,0"/>
                <TextBlock x:Name="NewOrdersBadge" Background="#3F51B5" Foreground="White"
                           Padding="8,2" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"
                           Text="0 новых"/>
                <TextBlock Text=" — " VerticalAlignment="Center" Foreground="Gray" Margin="8,0"/>
                <TextBlock x:Name="RecentOrderText" VerticalAlignment="Center"
                           Foreground="Gray" FontSize="12"
                           Text="Ожидаю заявки от клиентов..."/>
            </StackPanel>
        </Border>

        <!-- WebView2 с формой -->
        <Grid Grid.Row="2">
            <!-- WebView2 (если Runtime установлен) -->
            <wv2:WebView2 x:Name="WebView" Visibility="Collapsed"/>

            <!-- Fallback: встроенная форма как ScrollViewer -->
            <ScrollViewer x:Name="FallbackPanel" VerticalScrollBarVisibility="Auto"
                          Background="#F5F7FA">
                <StackPanel MaxWidth="680" Margin="40,24" HorizontalAlignment="Center">

                    <TextBlock Text="📋 Форма приёма заявки на доставку"
                               FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock Text="Заполните форму — заявка сразу появится в разделе «Заказы»"
                               Foreground="Gray" FontSize="13" Margin="0,0,0,24"/>

                    <!-- Клиент -->
                    <TextBox x:Name="WClientName"
                             materialDesign:HintAssist.Hint="Организация / ФИО клиента *"
                             materialDesign:HintAssist.IsFloating="True"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBox x:Name="WClientPhone" Width="250"
                                 materialDesign:HintAssist.Hint="Телефон"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,12,0"/>
                        <TextBox x:Name="WPrice" Width="220"
                                 materialDesign:HintAssist.Hint="Стоимость доставки (₽)"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                    </StackPanel>

                    <!-- Адрес -->
                    <TextBox x:Name="WAddress"
                             materialDesign:HintAssist.Hint="Адрес доставки *"
                             materialDesign:HintAssist.IsFloating="True"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,0,12"/>

                    <!-- Груз -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBox x:Name="WWeight" Width="200"
                                 materialDesign:HintAssist.Hint="Вес (кг)"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,12,0"/>
                        <TextBox x:Name="WVolume" Width="200"
                                 materialDesign:HintAssist.Hint="Объём (м³)"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                    </StackPanel>

                    <!-- Приоритет -->
                    <ComboBox x:Name="WPriority"
                              materialDesign:HintAssist.Hint="Приоритет"
                              materialDesign:HintAssist.IsFloating="True"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              SelectedIndex="1" Margin="0,0,0,12">
                        <ComboBoxItem Content="🟢 Низкий — без спешки"/>
                        <ComboBoxItem Content="🟡 Обычный"/>
                        <ComboBoxItem Content="🟠 Высокий"/>
                        <ComboBoxItem Content="🔴 Срочный — в день заявки"/>
                    </ComboBox>

                    <!-- Примечания -->
                    <TextBox x:Name="WNotes"
                             materialDesign:HintAssist.Hint="Примечания к заказу"
                             materialDesign:HintAssist.IsFloating="True"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             AcceptsReturn="True" Height="60" TextWrapping="Wrap"
                             Margin="0,0,0,20"/>

                    <TextBlock x:Name="WErrorText" Foreground="Red" TextWrapping="Wrap"
                               Margin="0,0,0,8" Visibility="Collapsed"/>
                    <TextBlock x:Name="WSuccessText" Foreground="#166534" TextWrapping="Wrap"
                               FontSize="14" FontWeight="Bold" Margin="0,0,0,8"
                               Visibility="Collapsed"/>

                    <Button Content="📦 Отправить заявку" Click="SubmitOrder_Click"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Height="46" FontSize="14"/>

                    <TextBlock Margin="0,12,0,0" Foreground="Gray" FontSize="12"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Text="После отправки заявка поступит диспетчеру. Он назначит водителя и свяжется с вами для подтверждения."/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
