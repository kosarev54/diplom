<UserControl x:Class="DispatcherARM.UI.Views.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Loaded="DashboardPage_Loaded"
             Background="#F0F2F5" FontFamily="Segoe UI">

    <UserControl.Resources>
        <!-- KPI-плитка -->
        <Style x:Key="KpiCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E4E8EE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>
        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1A2332"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>
        <Style x:Key="KpiLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#6B7B8D"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#8A9BAE"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E4E8EE"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="PanelHeader" TargetType="Border">
            <Setter Property="BorderBrush" Value="#E4E8EE"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Background" Value="#FAFBFC"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,14,16,20">

            <!-- ══ Заголовок страницы ══ -->
            <DockPanel Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="LastUpdateText" FontSize="11" Foreground="#9CA3AF"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button x:Name="RefreshBtn" Content="Обновить" Click="Refresh_Click"
                            Height="28" Padding="12,0" FontSize="12" Cursor="Hand"
                            Background="White" BorderBrush="#CBD5E0" BorderThickness="1">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="РАБОЧИЙ СТОЛ" FontSize="13" FontWeight="Bold"
                               Foreground="#1A2332"/>
                    <TextBlock x:Name="TodayDateText" FontSize="11" Foreground="#6B7B8D"/>
                </StackPanel>
            </DockPanel>

            <!-- ══ Строка 1: KPI-плитки ══ -->
            <TextBlock Text="КЛЮЧЕВЫЕ ПОКАЗАТЕЛИ" Style="{StaticResource SectionLabel}"/>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Всего заказов -->
                <Border Grid.Column="0" Style="{StaticResource KpiCard}"
                        BorderThickness="0,0,0,1">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#1E3A5F" Offset="0"/>
                            <GradientStop Color="#1E3A5F" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#1E3A5F"/>
                        <StackPanel Grid.Row="1" Margin="0,10,0,0">
                            <materialDesign:PackIcon Kind="ClipboardText" Width="20" Height="20"
                                                     Foreground="#1E3A5F"/>
                            <TextBlock x:Name="TotalOrdersText" Text="—" Style="{StaticResource KpiValue}"
                                       Foreground="#1E3A5F"/>
                            <TextBlock Text="Всего заказов" Style="{StaticResource KpiLabel}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Новые -->
                <Border Grid.Column="2" Style="{StaticResource KpiCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#F59E0B"/>
                        <StackPanel Grid.Row="1" Margin="0,10,0,0">
                            <materialDesign:PackIcon Kind="NewBox" Width="20" Height="20" Foreground="#F59E0B"/>
                            <TextBlock x:Name="NewOrdersText" Text="—" Style="{StaticResource KpiValue}"
                                       Foreground="#F59E0B"/>
                            <TextBlock Text="Новые / Не назначены" Style="{StaticResource KpiLabel}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- В пути -->
                <Border Grid.Column="4" Style="{StaticResource KpiCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#3B82F6"/>
                        <StackPanel Grid.Row="1" Margin="0,10,0,0">
                            <materialDesign:PackIcon Kind="Truck" Width="20" Height="20" Foreground="#3B82F6"/>
                            <TextBlock x:Name="InTransitText" Text="—" Style="{StaticResource KpiValue}"
                                       Foreground="#3B82F6"/>
                            <TextBlock Text="В пути / Погрузка" Style="{StaticResource KpiLabel}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Доставлено -->
                <Border Grid.Column="6" Style="{StaticResource KpiCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#10B981"/>
                        <StackPanel Grid.Row="1" Margin="0,10,0,0">
                            <materialDesign:PackIcon Kind="CheckCircle" Width="20" Height="20" Foreground="#10B981"/>
                            <TextBlock x:Name="DeliveredText" Text="—" Style="{StaticResource KpiValue}"
                                       Foreground="#10B981"/>
                            <TextBlock Text="Доставлено (всего)" Style="{StaticResource KpiLabel}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Водители -->
                <Border Grid.Column="8" Style="{StaticResource KpiCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#8B5CF6"/>
                        <StackPanel Grid.Row="1" Margin="0,10,0,0">
                            <materialDesign:PackIcon Kind="Account" Width="20" Height="20" Foreground="#8B5CF6"/>
                            <TextBlock x:Name="DriversAvailableText" Text="—" Style="{StaticResource KpiValue}"
                                       Foreground="#8B5CF6"/>
                            <TextBlock Text="Водителей свободно" Style="{StaticResource KpiLabel}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Отменено -->
                <Border Grid.Column="10" Style="{StaticResource KpiCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#EF4444"/>
                        <StackPanel Grid.Row="1" Margin="0,10,0,0">
                            <materialDesign:PackIcon Kind="Cancel" Width="20" Height="20" Foreground="#EF4444"/>
                            <TextBlock x:Name="CancelledText" Text="—" Style="{StaticResource KpiValue}"
                                       Foreground="#EF4444"/>
                            <TextBlock Text="Отменено" Style="{StaticResource KpiLabel}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══ Строка 2: Статус + Последние заказы ══ -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="2.5*"/>
                </Grid.ColumnDefinitions>

                <!-- Статус выполнения (прогресс-бары) -->
                <Border Grid.Column="0" Style="{StaticResource PanelCard}">
                    <StackPanel>
                        <Border Style="{StaticResource PanelHeader}">
                            <TextBlock Text="СТАТУС ВЫПОЛНЕНИЯ" FontSize="11" FontWeight="Bold"
                                       Foreground="#4A5568"/>
                        </Border>
                        <StackPanel Margin="14,12,14,14">
                            <TextBlock Text="Выполнение заказов сегодня" FontSize="11"
                                       Foreground="#6B7B8D" Margin="0,0,0,10"/>

                            <!-- Назначено -->
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock x:Name="AssignedPctText" DockPanel.Dock="Right"
                                           FontSize="11" Foreground="#6B7B8D" Width="40"
                                           TextAlignment="Right"/>
                                <TextBlock Text="Назначено" FontSize="11" Foreground="#4A5568"/>
                            </DockPanel>
                            <Border Height="6" Background="#F1F5F9" Margin="0,0,0,10">
                                <Border x:Name="AssignedBar" Background="#F59E0B" HorizontalAlignment="Left" Width="0"/>
                            </Border>

                            <!-- В пути -->
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock x:Name="TransitPctText" DockPanel.Dock="Right"
                                           FontSize="11" Foreground="#6B7B8D" Width="40"
                                           TextAlignment="Right"/>
                                <TextBlock Text="В пути" FontSize="11" Foreground="#4A5568"/>
                            </DockPanel>
                            <Border Height="6" Background="#F1F5F9" Margin="0,0,0,10">
                                <Border x:Name="TransitBar" Background="#3B82F6" HorizontalAlignment="Left" Width="0"/>
                            </Border>

                            <!-- Доставлено -->
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock x:Name="DeliveredPctText" DockPanel.Dock="Right"
                                           FontSize="11" Foreground="#6B7B8D" Width="40"
                                           TextAlignment="Right"/>
                                <TextBlock Text="Доставлено" FontSize="11" Foreground="#4A5568"/>
                            </DockPanel>
                            <Border Height="6" Background="#F1F5F9" Margin="0,0,0,16">
                                <Border x:Name="DeliveredBar" Background="#10B981" HorizontalAlignment="Left" Width="0"/>
                            </Border>

                            <Separator Background="#E4E8EE" Margin="0,0,0,10"/>

                            <!-- Итого -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Сегодня создано" Style="{StaticResource KpiLabel}"/>
                                    <TextBlock x:Name="TodayCreatedText" FontSize="20" FontWeight="Bold"
                                               Foreground="#1A2332"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="% выполнения" Style="{StaticResource KpiLabel}"/>
                                    <TextBlock x:Name="CompletionPctText" FontSize="20" FontWeight="Bold"
                                               Foreground="#10B981"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Последние заказы -->
                <Border Grid.Column="2" Style="{StaticResource PanelCard}">
                    <StackPanel>
                        <Border Style="{StaticResource PanelHeader}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" FontSize="11" Foreground="#3B82F6"
                                           Text="последние 10" VerticalAlignment="Center"/>
                                <TextBlock Text="ПОСЛЕДНИЕ ЗАКАЗЫ" FontSize="11" FontWeight="Bold"
                                           Foreground="#4A5568"/>
                            </DockPanel>
                        </Border>
                        <DataGrid x:Name="RecentOrdersGrid" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False"
                                  HeadersVisibility="Column" MaxHeight="220"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F1F5F9"
                                  BorderThickness="0"
                                  RowHeight="30" FontSize="12"
                                  Background="White">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#FAFBFC"/>
                                    <Setter Property="Foreground" Value="#6B7B8D"/>
                                    <Setter Property="FontSize" Value="10"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="10,4"/>
                                    <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="№" Binding="{Binding OrderNumber}" Width="80"/>
                                <DataGridTextColumn Header="Клиент" Binding="{Binding ClientName}" Width="*"/>
                                <DataGridTextColumn Header="Дата доставки" Binding="{Binding DeliveryDateStr}" Width="95"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding StatusDisplay}" Width="105"/>
                                <DataGridTextColumn Header="Водитель" Binding="{Binding DriverName}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══ Строка 3: Водители + ТС ══ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Водители -->
                <Border Grid.Column="0" Style="{StaticResource PanelCard}">
                    <StackPanel>
                        <Border Style="{StaticResource PanelHeader}">
                            <TextBlock Text="ВОДИТЕЛИ — ТЕКУЩИЙ СТАТУС" FontSize="11"
                                       FontWeight="Bold" Foreground="#4A5568"/>
                        </Border>
                        <DataGrid x:Name="DriversGrid" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False"
                                  HeadersVisibility="Column" MaxHeight="200"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F1F5F9"
                                  BorderThickness="0" RowHeight="28"
                                  FontSize="12" Background="White">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#FAFBFC"/>
                                    <Setter Property="Foreground" Value="#6B7B8D"/>
                                    <Setter Property="FontSize" Value="10"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="10,4"/>
                                    <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="115"/>
                                <DataGridTextColumn Header="ТС" Binding="{Binding VehiclePlate}" Width="90"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding StatusDisplay}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Транспорт -->
                <Border Grid.Column="2" Style="{StaticResource PanelCard}">
                    <StackPanel>
                        <Border Style="{StaticResource PanelHeader}">
                            <TextBlock Text="ТРАНСПОРТНЫЕ СРЕДСТВА" FontSize="11"
                                       FontWeight="Bold" Foreground="#4A5568"/>
                        </Border>
                        <DataGrid x:Name="VehiclesGrid" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False"
                                  HeadersVisibility="Column" MaxHeight="200"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F1F5F9"
                                  BorderThickness="0" RowHeight="28"
                                  FontSize="12" Background="White">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#FAFBFC"/>
                                    <Setter Property="Foreground" Value="#6B7B8D"/>
                                    <Setter Property="FontSize" Value="10"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="10,4"/>
                                    <Setter Property="BorderBrush" Value="#E4E8EE"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Гос. номер" Binding="{Binding LicensePlate}" Width="95"/>
                                <DataGridTextColumn Header="Модель" Binding="{Binding Model}" Width="*"/>
                                <DataGridTextColumn Header="Тип" Binding="{Binding TypeDisplay}" Width="90"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding StatusDisplay}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
