<UserControl x:Class="DispatcherARM.UI.Views.Pages.OrdersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#F0F2F5"
             Loaded="OrdersPage_Loaded">

    <UserControl.Resources>
        <!-- Стиль кнопки тулбара -->
        <Style x:Key="ToolbarBtn" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EBF4FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#90B8D9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F7F9FC"/>
                                <Setter Property="Foreground" Value="#A0AEC0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Основная кнопка действия -->
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource ToolbarBtn}">
            <Setter Property="Background" Value="#1E3A5F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1E3A5F"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2D4F72"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Зелёная кнопка -->
        <Style x:Key="SuccessBtn" TargetType="Button" BasedOn="{StaticResource ToolbarBtn}">
            <Setter Property="Background" Value="#276749"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#276749"/>
        </Style>

        <!-- Красная кнопка -->
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ToolbarBtn}">
            <Setter Property="Foreground" Value="#C62828"/>
            <Setter Property="BorderBrush" Value="#FECACA"/>
            <Setter Property="Background" Value="#FFF5F5"/>
        </Style>

        <!-- Жёлтая кнопка -->
        <Style x:Key="WarningBtn" TargetType="Button" BasedOn="{StaticResource ToolbarBtn}">
            <Setter Property="Background" Value="#7B4F12"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#7B4F12"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Заголовок страницы -->
            <RowDefinition Height="Auto"/>
            <!-- Тулбар -->
            <RowDefinition Height="Auto"/>
            <!-- Фильтры -->
            <RowDefinition Height="*"/>
            <!-- Таблица -->
            <RowDefinition Height="Auto"/>
            <!-- Строка состояния -->
        </Grid.RowDefinitions>

        <!-- ── Заголовок страницы ── -->
        <Border Background="White" BorderBrush="#D0D7DE" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="CountBadge" Background="#EBF4FF" Foreground="#1E3A5F"
                               Padding="8,2" FontSize="11" FontWeight="SemiBold"
                               VerticalAlignment="Center" Text="Загрузка..."/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Заказы на доставку" FontSize="16" FontWeight="SemiBold"
                               Foreground="#1A2332"/>
                    <TextBlock Foreground="#6B7B8D" FontSize="11" Margin="0,1,0,0">
                        <Run Text="Главная"/>
                        <Run Text=" › "/>
                        <Run Text="Заказы"/>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Панель инструментов ── -->
        <Border Grid.Row="1" Background="#F7F9FC" BorderBrush="#D0D7DE"
                BorderThickness="0,0,0,1" Padding="12,6">
            <DockPanel>
                <!-- Левая группа -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="＋  Новый заказ" Click="AddOrder_Click"
                            Style="{StaticResource PrimaryBtn}" Margin="0,0,4,0"/>
                    <Button Content="Импорт CSV" Click="ImportCsv_Click"
                            Style="{StaticResource ToolbarBtn}" Margin="0,0,4,0"/>
                    <Button Content="Веб-заявки" Click="WebServer_Click"
                            Style="{StaticResource ToolbarBtn}" Margin="0,0,4,0"/>
                    <Separator Width="1" Background="#D0D7DE" Margin="6,2"/>
                    <Button x:Name="AssignBtn" Content="Назначить водителя" Click="AssignOrder_Click"
                            Style="{StaticResource ToolbarBtn}" IsEnabled="False" Margin="4,0,4,0"/>
                    <Button x:Name="LoadingBtn" Content="Подтвердить погрузку" Click="ConfirmLoading_Click"
                            Style="{StaticResource WarningBtn}" IsEnabled="False" Margin="0,0,4,0"/>
                    <Button x:Name="ConfirmBtn" Content="Выполнен" Click="ConfirmOrder_Click"
                            Style="{StaticResource SuccessBtn}" IsEnabled="False" Margin="0,0,4,0"/>
                    <Separator Width="1" Background="#D0D7DE" Margin="6,2"/>
                    <Button x:Name="WaybillBtn" Content="Путевой лист" Click="Waybill_Click"
                            Style="{StaticResource ToolbarBtn}" IsEnabled="False" Margin="4,0,4,0"/>
                    <Button x:Name="TtnBtn" Content="ТТН" Click="Ttn_Click"
                            Style="{StaticResource ToolbarBtn}" IsEnabled="False" Margin="0,0,4,0"/>
                    <Separator Width="1" Background="#D0D7DE" Margin="6,2"/>
                    <Button x:Name="EditBtn" Content="Изменить" Click="EditOrder_Click"
                            Style="{StaticResource ToolbarBtn}" IsEnabled="False" Margin="4,0,4,0"/>
                    <Button x:Name="CancelBtn" Content="Отменить" Click="CancelOrder_Click"
                            Style="{StaticResource DangerBtn}" IsEnabled="False" Margin="0,0,4,0"/>
                </StackPanel>

                <!-- Правая группа — обновить -->
                <Button Content="⟳ Обновить" Click="RefreshOrders_Click" DockPanel.Dock="Right"
                        Style="{StaticResource ToolbarBtn}"/>
            </DockPanel>
        </Border>

        <!-- ── Строка фильтров ── -->
        <Border Grid.Row="2" Background="White" BorderBrush="#D0D7DE"
                BorderThickness="0,0,0,1" Padding="12,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Фильтр:" VerticalAlignment="Center"
                           FontSize="12" Foreground="#6B7B8D" Margin="0,0,8,0"/>
                <ComboBox x:Name="StatusFilter" Width="140" FontSize="12"
                          SelectionChanged="StatusFilter_Changed"
                          BorderBrush="#CBD5E0" BorderThickness="1"
                          Padding="6,4" Margin="0,0,8,0"
                          VerticalContentAlignment="Center">
                    <ComboBoxItem Content="Все статусы" IsSelected="True"/>
                    <ComboBoxItem Content="Новые"/>
                    <ComboBoxItem Content="Назначенные"/>
                    <ComboBoxItem Content="Погрузка"/>
                    <ComboBoxItem Content="В пути"/>
                    <ComboBoxItem Content="Выполненные"/>
                    <ComboBoxItem Content="Отменённые"/>
                </ComboBox>

                <TextBlock Text="Поиск:" VerticalAlignment="Center"
                           FontSize="12" Foreground="#6B7B8D" Margin="0,0,8,0"/>
                <Border BorderBrush="#CBD5E0" BorderThickness="1" CornerRadius="3"
                        Background="White">
                    <TextBox x:Name="SearchBox" Width="220" BorderThickness="0"
                             Padding="6,4" FontSize="12"
                             TextChanged="SearchBox_TextChanged"
                             materialDesign:HintAssist.Hint="Клиент, адрес, номер..."
                             materialDesign:HintAssist.IsFloating="False"
                             Style="{StaticResource MaterialDesignTextBox}"/>
                </Border>

                <TextBlock Text="Дата:" VerticalAlignment="Center"
                           FontSize="12" Foreground="#6B7B8D" Margin="12,0,8,0"/>
                <Border BorderBrush="#CBD5E0" BorderThickness="1" CornerRadius="3"
                        Background="White">
                    <DatePicker x:Name="DateFilter" BorderThickness="0" Padding="4,2"
                                FontSize="12" SelectedDateChanged="DateFilter_Changed"
                                Width="120"/>
                </Border>
                <Button Content="Сбросить" Click="ClearFilters_Click"
                        Style="{StaticResource ToolbarBtn}" Margin="6,0,0,0" FontSize="11"/>
            </StackPanel>
        </Border>

        <!-- ── Таблица заказов ── -->
        <DataGrid x:Name="OrdersGrid" Grid.Row="3"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" SelectionMode="Single"
                  SelectionChanged="OrdersGrid_SelectionChanged"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E8ECF0"
                  RowHeight="28"
                  FontSize="12"
                  BorderThickness="0"
                  Background="White"
                  AlternatingRowBackground="#F9FAFB"
                  ColumnHeaderHeight="32">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#F4F5F7"/>
                    <Setter Property="Foreground" Value="#4A5568"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Padding" Value="8,0"/>
                    <Setter Property="BorderBrush" Value="#D0D7DE"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="SeparatorBrush" Value="#D0D7DE"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="8,0"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#D6E4F0"/>
                            <Setter Property="Foreground" Value="#1A2332"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="Delivered">
                            <Setter Property="Foreground" Value="#276749"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                            <Setter Property="Foreground" Value="#A0AEC0"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Loading">
                            <Setter Property="Background" Value="#FFFBEB"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="New">
                            <Setter Property="Background" Value="#EBF8FF"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="№ Заказа"     Binding="{Binding OrderNumber}"  Width="110"/>
                <DataGridTextColumn Header="Клиент"       Binding="{Binding ClientName}"   Width="160"/>
                <DataGridTextColumn Header="Адрес доставки" Binding="{Binding Address}"    Width="*"/>
                <DataGridTextColumn Header="Вес, кг"      Binding="{Binding Weight, StringFormat=F1}" Width="70"/>
                <DataGridTextColumn Header="Стоимость"    Binding="{Binding DeliveryPrice, StringFormat=N0}" Width="85"/>
                <DataGridTextColumn Header="Приоритет"    Binding="{Binding PriorityDisplay}" Width="85"/>
                <DataGridTextColumn Header="Статус"       Binding="{Binding StatusDisplay}" Width="130"/>
                <DataGridTextColumn Header="Водитель"     Binding="{Binding AssignedDriver.FullName}" Width="140"/>
                <DataGridTextColumn Header="Дата"         Binding="{Binding DeliveryDate, StringFormat=dd.MM.yyyy}" Width="90"/>
                <DataGridTextColumn Header="Выполнен"     Binding="{Binding CompletedAt, StringFormat=dd.MM HH:mm}" Width="100"/>
                <DataGridTextColumn Header="Источник"     Binding="{Binding SourceDisplay}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ── Строка состояния таблицы ── -->
        <Border Grid.Row="4" Background="White" BorderBrush="#D0D7DE"
                BorderThickness="0,1,0,0" Padding="12,4">
            <DockPanel>
                <TextBlock x:Name="SelectedInfoText" Foreground="#6B7B8D" FontSize="11"
                           VerticalAlignment="Center"
                           Text="Выберите запись для работы с ней"/>
                <TextBlock x:Name="GridCountText" DockPanel.Dock="Right"
                           Foreground="#6B7B8D" FontSize="11" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
