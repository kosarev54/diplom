<UserControl x:Class="DispatcherARM.UI.Views.Pages.MapPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Loaded="MapPage_Loaded">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ══ Левая панель ══ -->
        <Border Background="White" BorderBrush="#E8EAF0" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="14,14,14,8">
                    <TextBlock Text="Карта доставок"
                               Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                               Margin="0,0,0,12" />

                    <TextBlock Text="СЛОИ" FontSize="10" FontWeight="Bold"
                               Foreground="Gray" Margin="0,0,0,6" />
                    <CheckBox x:Name="ShowOrdersCheck" Content="📍 Точки доставки"
                              IsChecked="True" Checked="LayerChanged" Unchecked="LayerChanged"
                              Margin="0,0,0,4" />
                    <CheckBox x:Name="ShowRoutesCheck" Content="🗺️ Маршруты"
                              IsChecked="True" Checked="LayerChanged" Unchecked="LayerChanged"
                              Margin="0,0,0,12" />

                    <TextBlock Text="МАРШРУТЫ" FontSize="10" FontWeight="Bold"
                               Foreground="Gray" Margin="0,0,0,6" />
                </StackPanel>

                <!-- Список маршрутов -->
                <ListBox x:Name="RoutesList" Grid.Row="1"
                         SelectionMode="Single"
                         SelectionChanged="RoutesList_SelectionChanged"
                         Style="{StaticResource MaterialDesignListBox}"
                         Margin="4,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,6">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="12" Height="12" CornerRadius="6"
                                            Background="{Binding ColorHex}"
                                            Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" FontWeight="Medium"
                                               TextWrapping="Wrap" MaxWidth="160" />
                                </StackPanel>
                                <TextBlock Text="{Binding Info}" FontSize="11"
                                           Foreground="Gray" Margin="20,2,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="14,8,14,14">
                    <Button Content="🔄 Обновить" Click="Refresh_Click"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                    <Button Content="⬅ Все маршруты" Click="ShowAll_Click"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            HorizontalAlignment="Stretch" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Карта через WebView2 ══ -->
        <Grid Grid.Column="1">
            <!-- Индикатор загрузки пока карта инициализируется -->
            <StackPanel x:Name="LoadingPanel"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="Visible">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4"
                             Margin="0,0,0,12" />
                <TextBlock Text="Загрузка карты..." HorizontalAlignment="Center"
                           Foreground="Gray" />
            </StackPanel>

            <!-- WebView2 с картой Leaflet -->
            <wv2:WebView2 x:Name="MapWebView"
                          Visibility="Collapsed" />

            <!-- Баннер выбранного маршрута -->
            <Border x:Name="SelectedRouteBanner" Visibility="Collapsed"
                    Background="#CC3F51B5" CornerRadius="0,0,8,0"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Padding="16,8" Margin="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="SelectedRouteText" Foreground="White"
                               FontSize="13" FontWeight="Medium"
                               VerticalAlignment="Center" />
                    <Button Content="✕" Click="ClearSelection_Click"
                            Foreground="White" Background="Transparent"
                            BorderThickness="0" Margin="10,0,0,0"
                            FontSize="14" Cursor="Hand" Padding="4,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
