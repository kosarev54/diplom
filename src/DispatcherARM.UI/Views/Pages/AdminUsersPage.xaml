<UserControl x:Class="DispatcherARM.UI.Views.Pages.AdminUsersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Loaded="Page_Loaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <TextBlock Text="Управление пользователями"
                       Style="{StaticResource MaterialDesignHeadline5TextBlock}" />
            <Button Content="🔄 Обновить" Click="Refresh_Click"
                    DockPanel.Dock="Right" HorizontalAlignment="Right"
                    Style="{StaticResource MaterialDesignOutlinedButton}" />
        </DockPanel>

        <!-- Фильтр -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <ComboBox x:Name="FilterBox" Width="160"
                      materialDesign:HintAssist.Hint="Фильтр"
                      materialDesign:HintAssist.IsFloating="True"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Все" IsSelected="True" />
                <ComboBoxItem Content="⏳ Ожидают подтверждения" />
                <ComboBoxItem Content="✅ Активные" />
                <ComboBoxItem Content="❌ Заблокированные" />
            </ComboBox>
        </StackPanel>

        <!-- Таблица -->
        <DataGrid x:Name="UsersGrid" Grid.Row="2"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  SelectionChanged="UsersGrid_SelectionChanged"
                  materialDesign:DataGridAssist.CellPadding="8 5" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Логин"    Binding="{Binding Login}"    Width="100" />
                <DataGridTextColumn Header="Имя"      Binding="{Binding FullName}" Width="*" />
                <DataGridTextColumn Header="Роль"     Binding="{Binding RoleDisplay}" Width="100" />
                <DataGridTextColumn Header="Email"    Binding="{Binding Email}"    Width="150" />
                <DataGridTextColumn Header="Дата рег." Binding="{Binding RegisteredAt, StringFormat=dd.MM.yyyy}" Width="100" />
                <DataGridTextColumn Header="Статус"   Binding="{Binding StatusDisplay}" Width="130" />
                <DataGridTextColumn Header="Баланс"   Binding="{Binding BalanceDisplay}" Width="90" />
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                    <Style.Triggers>
                        <!-- Ожидают подтверждения — нежно-голубой -->
                        <DataTrigger Binding="{Binding IsApproved}" Value="False">
                            <Setter Property="Background" Value="#EFF6FF" />
                        </DataTrigger>
                        <!-- Заблокированные — светло-серый -->
                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                            <Setter Property="Background" Value="#F3F4F6" />
                            <Setter Property="Foreground" Value="#9CA3AF" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>

        <!-- Панель действий (поверх таблицы снизу) -->
        <Border Grid.Row="2" VerticalAlignment="Bottom" Background="{DynamicResource MaterialDesign.Brush.Card}"
                BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}"
                BorderThickness="0,1,0,0" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Выбранный пользователь:" VerticalAlignment="Center"
                           Foreground="Gray" Margin="0,0,12,0" />
                <Button x:Name="ApproveBtn" Content="✅ Подтвердить регистрацию"
                        Click="Approve_Click"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Foreground="#2E7D32" BorderBrush="#2E7D32"
                        IsEnabled="False" Margin="0,0,8,0" />
                <Button x:Name="BlockBtn" Content="🚫 Заблокировать"
                        Click="Block_Click"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Foreground="#C62828" BorderBrush="#C62828"
                        IsEnabled="False" Margin="0,0,8,0" />
                <Button x:Name="UnblockBtn" Content="🔓 Разблокировать"
                        Click="Unblock_Click"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        IsEnabled="False" Margin="0,0,8,0" />
                <Button x:Name="ResetPassBtn" Content="🔑 Сбросить пароль"
                        Click="ResetPass_Click"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        IsEnabled="False" Margin="0,0,8,0"/>
                <Button x:Name="PenaltyBonusBtn" Content="💰 Штраф / Бонус"
                        Click="PenaltyBonus_Click"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Foreground="#B45309" BorderBrush="#B45309"
                        IsEnabled="False" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
