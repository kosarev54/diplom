<UserControl x:Class="DispatcherARM.UI.Views.Pages.VehiclesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Loaded="VehiclesPage_Loaded">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <TextBlock Text="Транспортные средства" Style="{StaticResource MaterialDesignHeadline5TextBlock}" />
            <Button Content="Добавить ТС" Click="AddVehicle_Click"
                    DockPanel.Dock="Right" HorizontalAlignment="Right"
                    Style="{StaticResource MaterialDesignRaisedButton}" materialDesign:ButtonAssist.CornerRadius="4" />
        </DockPanel>

        <TextBlock Grid.Row="1" Text="💡 Двойной клик по строке — открыть карточку ТС"
                   Foreground="Gray" FontSize="11" Margin="0,0,0,8" />

        <DataGrid x:Name="VehiclesGrid" Grid.Row="2"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  materialDesign:DataGridAssist.CellPadding="8 4" HeadersVisibility="Column"
                  MouseDoubleClick="VehiclesGrid_DoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Гос. номер" Binding="{Binding LicensePlate}" Width="100" />
                <DataGridTextColumn Header="Модель" Binding="{Binding Model}" Width="*" />
                <DataGridTextColumn Header="Год" Binding="{Binding Year}" Width="55" />
                <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="100" />
                <DataGridTextColumn Header="Г/п (кг)" Binding="{Binding MaxWeightKg, StringFormat=N0}" Width="80" />
                <DataGridTextColumn Header="Объём (м³)" Binding="{Binding MaxVolumeM3}" Width="80" />
                <DataGridTextColumn Header="Расход" Binding="{Binding FuelConsumptionPer100Km, StringFormat=F1}" Width="65" />
                <DataGridTextColumn Header="Пробег (км)" Binding="{Binding OdometerKm, StringFormat=N0}" Width="100" />
                <DataGridTextColumn Header="Посл. ТО" Binding="{Binding LastMaintenanceDate, StringFormat=dd.MM.yyyy}" Width="95" />
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100" />
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Cursor" Value="Hand" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
    </Grid>
</UserControl>
