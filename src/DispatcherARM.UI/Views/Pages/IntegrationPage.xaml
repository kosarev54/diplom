<UserControl x:Class="DispatcherARM.UI.Views.Pages.IntegrationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Loaded="Page_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">

            <!-- Заголовок -->
            <Border Background="#3F51B5" CornerRadius="10" Padding="20,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🔗 Интеграция с 1С:Предприятие"
                               Foreground="White" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Foreground="#C5CAE9" FontSize="13" Margin="0,4,0,0"
                               Text="Файловый обмен JSON — стандартный механизм «Универсального обмена данными»"/>
                </StackPanel>
            </Border>

            <!-- Схема бизнес-процесса -->
            <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,12"
                    BorderBrush="#E8EAF0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="📋 БИЗНЕС-ПРОЦЕСС" FontSize="11" FontWeight="Bold"
                               Foreground="#6B7280" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Background="#EFF6FF" CornerRadius="8" Padding="14,10" Margin="4,0" Width="130">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🏪" FontSize="24" HorizontalAlignment="Center"/>
                                <TextBlock Text="Магазин" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,2"/>
                                <TextBlock Text="Формирует заказ" FontSize="11" Foreground="Gray" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="→" FontSize="24" VerticalAlignment="Center" Margin="4,0" Foreground="#3F51B5"/>
                        <Border Background="#EFF6FF" CornerRadius="8" Padding="14,10" Margin="4,0" Width="130">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🔗" FontSize="24" HorizontalAlignment="Center"/>
                                <TextBlock Text="1С" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,2"/>
                                <TextBlock Text="orders_from_1c.json" FontSize="11" Foreground="Gray" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="→" FontSize="24" VerticalAlignment="Center" Margin="4,0" Foreground="#3F51B5"/>
                        <Border Background="#F0FDF4" CornerRadius="8" Padding="14,10" Margin="4,0" Width="130">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🖥️" FontSize="24" HorizontalAlignment="Center"/>
                                <TextBlock Text="АРМ" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,2"/>
                                <TextBlock Text="Назначает водителя" FontSize="11" Foreground="Gray" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="→" FontSize="24" VerticalAlignment="Center" Margin="4,0" Foreground="#3F51B5"/>
                        <Border Background="#FFF7ED" CornerRadius="8" Padding="14,10" Margin="4,0" Width="130">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🚚" FontSize="24" HorizontalAlignment="Center"/>
                                <TextBlock Text="Водитель" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,2"/>
                                <TextBlock Text="Доставляет" FontSize="11" Foreground="Gray" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="→" FontSize="24" VerticalAlignment="Center" Margin="4,0" Foreground="#3F51B5"/>
                        <Border Background="#F0FDF4" CornerRadius="8" Padding="14,10" Margin="4,0" Width="130">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="✅" FontSize="24" HorizontalAlignment="Center"/>
                                <TextBlock Text="1С" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,2"/>
                                <TextBlock Text="statuses_to_1c.json" FontSize="11" Foreground="Gray" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Настройка папки обмена -->
            <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,12"
                    BorderBrush="#E8EAF0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="📁 ПАПКА ОБМЕНА С 1С" FontSize="11" FontWeight="Bold"
                               Foreground="#6B7280" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox x:Name="FolderBox" Width="460"
                                 materialDesign:HintAssist.Hint="Путь к общей папке (например: C:\1C_Exchange)"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,8,0"/>
                        <Button Content="📂 Обзор" Click="BrowseFolder_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                materialDesign:ButtonAssist.CornerRadius="4" Margin="0,0,8,0"/>
                        <Button Content="✅ Применить" Click="ApplyFolder_Click"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                materialDesign:ButtonAssist.CornerRadius="4"/>
                    </StackPanel>
                    <TextBlock Foreground="Gray" FontSize="11" TextWrapping="Wrap"
                               Text="💡 Укажите сетевую папку, доступную и АРМ Диспетчера, и серверу 1С. В 1С настройте выгрузку в эту папку. АРМ будет автоматически подхватывать новые файлы orders_from_1c*.json"/>
                </StackPanel>
            </Border>

            <!-- Статус мониторинга + кнопки -->
            <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,12"
                    BorderBrush="#E8EAF0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="🔄 СТАТУС МОНИТОРИНГА" FontSize="11" FontWeight="Bold"
                                   Foreground="#6B7280" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Ellipse x:Name="WatchDot" Width="12" Height="12"
                                     VerticalAlignment="Center" Margin="0,0,8,0"
                                     Fill="#EF4444"/>
                            <TextBlock x:Name="WatchText" VerticalAlignment="Center"
                                       FontSize="14" FontWeight="SemiBold"
                                       Text="Мониторинг не активен"/>
                        </StackPanel>
                        <TextBlock x:Name="WatchFolderText" Foreground="Gray" FontSize="12"
                                   Text="Папка обмена: не задана"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="StartWatchBtn" Content="▶ Запустить мониторинг"
                                Click="StartWatch_Click"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#2E7D32" Foreground="White"
                                materialDesign:ButtonAssist.CornerRadius="4" Margin="0,0,8,0"/>
                        <Button x:Name="StopWatchBtn" Content="⏹ Остановить"
                                Click="StopWatch_Click" IsEnabled="False"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="#C62828" BorderBrush="#C62828"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Ручные операции -->
            <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,12"
                    BorderBrush="#E8EAF0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="⚙️ РУЧНЫЕ ОПЕРАЦИИ" FontSize="11" FontWeight="Bold"
                               Foreground="#6B7280" Margin="0,0,0,12"/>
                    <WrapPanel>
                        <Button Content="📥 Импортировать файл из 1С" Click="ImportFile_Click"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#3F51B5" Foreground="White"
                                materialDesign:ButtonAssist.CornerRadius="4" Margin="0,0,8,8"/>
                        <Button Content="📤 Экспортировать статусы в 1С" Click="ExportStatuses_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                materialDesign:ButtonAssist.CornerRadius="4" Margin="0,0,8,8"/>
                        <Button Content="📋 Создать тестовый файл" Click="GenerateSample_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                materialDesign:ButtonAssist.CornerRadius="4" Margin="0,0,8,8"/>
                        <Button Content="📂 Открыть папку" Click="OpenFolder_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                materialDesign:ButtonAssist.CornerRadius="4" Margin="0,0,8,8"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Лог обмена -->
            <Border Background="White" CornerRadius="10" Padding="20"
                    BorderBrush="#E8EAF0" BorderThickness="1">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="📜 ЛОГ ОБМЕНА" FontSize="11" FontWeight="Bold"
                                   Foreground="#6B7280" VerticalAlignment="Center"/>
                        <Button Content="🗑 Очистить" Click="ClearLog_Click"
                                DockPanel.Dock="Right"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                FontSize="11" Padding="10,4"/>
                    </DockPanel>
                    <Border BorderBrush="#E8EAF0" BorderThickness="1" CornerRadius="6"
                            Padding="12" Height="200">
                        <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto"
                                      CanContentScroll="False">
                            <TextBlock x:Name="LogText" TextWrapping="Wrap"
                                       FontFamily="Courier New" FontSize="11"
                                       Foreground="#374151"
                                       Text="Операции обмена с 1С появятся здесь..."/>
                        </ScrollViewer>
                    </Border>

                    <!-- Статистика -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Border Background="#EFF6FF" CornerRadius="6" Padding="12,8" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="ИМПОРТИРОВАНО" FontSize="10" Foreground="#3F51B5"/>
                                <TextBlock x:Name="ImportedCountText" Text="0"
                                           FontSize="22" FontWeight="Bold" Foreground="#3F51B5"/>
                                <TextBlock Text="заказов из 1С" FontSize="11" Foreground="Gray"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#F0FDF4" CornerRadius="6" Padding="12,8" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="ЭКСПОРТИРОВАНО" FontSize="10" Foreground="#166534"/>
                                <TextBlock x:Name="ExportedCountText" Text="0"
                                           FontSize="22" FontWeight="Bold" Foreground="#166534"/>
                                <TextBlock Text="статусов в 1С" FontSize="11" Foreground="Gray"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#FFF7ED" CornerRadius="6" Padding="12,8">
                            <StackPanel>
                                <TextBlock Text="ПОСЛЕДНИЙ ОБМЕН" FontSize="10" Foreground="#92400E"/>
                                <TextBlock x:Name="LastSyncText" Text="—"
                                           FontSize="14" FontWeight="Bold" Foreground="#92400E"/>
                                <TextBlock Text="дата и время" FontSize="11" Foreground="Gray"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
