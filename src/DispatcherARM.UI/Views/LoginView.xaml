<Window x:Class="DispatcherARM.UI.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="АРМ Диспетчера — Вход в систему"
        Width="900" Height="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F0F2F5"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══ Левая панель — форма входа ══ -->
        <Border Background="White" BorderBrush="#D0D7DE" BorderThickness="0,0,1,0">
            <StackPanel VerticalAlignment="Center" Margin="50,0">

                <!-- Логотип -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,28">
                    <Border Background="#1E3A5F" Width="36" Height="36" CornerRadius="4"
                            VerticalAlignment="Center" Margin="0,0,12,0">
                        <materialDesign:PackIcon Kind="TruckDelivery" Width="22" Height="22"
                                                 Foreground="White"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="АРМ Диспетчера" FontSize="16" FontWeight="Bold"
                                   Foreground="#1E3A5F"/>
                        <TextBlock Text="Транспортно-логистическая система"
                                   FontSize="11" Foreground="#6B7B8D"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="Вход в систему" FontSize="22" FontWeight="SemiBold"
                           Foreground="#1A2332" Margin="0,0,0,6"/>
                <TextBlock Text="Введите учётные данные для работы с АРМ"
                           FontSize="12" Foreground="#6B7B8D" Margin="0,0,0,24"/>

                <!-- Поле логина -->
                <TextBlock Text="Логин" FontSize="12" Foreground="#4A5568" Margin="0,0,0,4"/>
                <Border BorderBrush="#CBD5E0" BorderThickness="1" CornerRadius="4"
                        Background="White" Margin="0,0,0,14">
                    <TextBox x:Name="LoginBox" BorderThickness="0" Padding="10,8"
                             FontSize="13" Background="Transparent"
                             KeyDown="Input_KeyDown"
                             TextChanged="LoginBox_TextChanged"/>
                </Border>

                <!-- Статус аккаунта -->
                <Border x:Name="StatusBorder" CornerRadius="4" Padding="10,6"
                        Margin="0,0,0,10" Visibility="Collapsed">
                    <StackPanel x:Name="StatusPanel" Orientation="Horizontal">
                        <TextBlock x:Name="StatusIcon" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusText" TextWrapping="Wrap"
                                   VerticalAlignment="Center" FontSize="12" FontWeight="Medium"/>
                    </StackPanel>
                </Border>

                <!-- Поле пароля -->
                <TextBlock Text="Пароль" FontSize="12" Foreground="#4A5568" Margin="0,0,0,4"/>
                <Border BorderBrush="#CBD5E0" BorderThickness="1" CornerRadius="4"
                        Background="White" Margin="0,0,0,6">
                    <PasswordBox x:Name="PasswordBox" BorderThickness="0" Padding="10,8"
                                 FontSize="13" Background="Transparent"
                                 KeyDown="Input_KeyDown"/>
                </Border>

                <!-- Ошибка -->
                <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" Margin="0,0,0,10">
                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                            CornerRadius="4" Padding="10,7">
                        <StackPanel>
                            <TextBlock x:Name="ErrorText" TextWrapping="Wrap"
                                       Foreground="#C62828" FontSize="12"/>
                            <TextBlock x:Name="AttemptsText" Foreground="#E53E3E"
                                       FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Кнопка ВОЙТИ -->
                <Button x:Name="LoginButton"
                        Content="ВОЙТИ В СИСТЕМУ"
                        Click="LoginButton_Click"
                        Height="40" FontSize="13" FontWeight="SemiBold"
                        HorizontalAlignment="Stretch"
                        Background="#1E3A5F" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Margin="0,8,0,16">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#2D4F72"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Background" Value="#9BAAB8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Separator Background="#E8ECF0" Margin="0,0,0,12"/>

                <!-- Регистрация -->
                <Button Content="Создать учётную запись"
                        Click="Register_Click"
                        Background="Transparent" BorderThickness="0"
                        FontSize="12" Foreground="#1E3A5F"
                        HorizontalAlignment="Center" Cursor="Hand"
                        materialDesign:ButtonAssist.CornerRadius="0"
                        Style="{StaticResource MaterialDesignFlatButton}"/>

                <!-- Прогресс -->
                <ProgressBar x:Name="ProgressBar"
                             IsIndeterminate="True"
                             Visibility="Collapsed"
                             Height="2" Margin="0,16,0,0"
                             Background="Transparent"
                             Foreground="#1E3A5F"/>

                <TextBlock Text="v2.0  ·  ВлГУ, 09.03.03 — Прикладная информатика"
                           Foreground="#B0BAC9" FontSize="10"
                           HorizontalAlignment="Center" Margin="0,24,0,0"/>
            </StackPanel>
        </Border>

        <!-- ══ Правая панель — информационная ══ -->
        <Border Grid.Column="1" Background="#1E3A5F">
            <StackPanel VerticalAlignment="Center" Margin="48,0">

                <materialDesign:PackIcon Kind="TruckDelivery" Width="56" Height="56"
                                         Foreground="#7BAFD4" Margin="0,0,0,24"/>

                <TextBlock Text="Транспортная логистика" FontSize="22" FontWeight="Bold"
                           Foreground="White" Margin="0,0,0,8"/>
                <TextBlock Text="Автоматизированное рабочее место диспетчера"
                           FontSize="14" Foreground="#7BAFD4" Margin="0,0,0,32"/>

                <!-- Возможности системы -->
                <StackPanel Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Background="#2D4F72" Width="28" Height="28" CornerRadius="14" Margin="0,0,12,0">
                            <materialDesign:PackIcon Kind="Check" Width="16" Height="16"
                                                     Foreground="#4CAF50"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Управление заказами и маршрутами" Foreground="#C8D8E8"
                                   FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Background="#2D4F72" Width="28" Height="28" CornerRadius="14" Margin="0,0,12,0">
                            <materialDesign:PackIcon Kind="Check" Width="16" Height="16"
                                                     Foreground="#4CAF50"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Официальные документы: путевой лист, ТТН" Foreground="#C8D8E8"
                                   FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Background="#2D4F72" Width="28" Height="28" CornerRadius="14" Margin="0,0,12,0">
                            <materialDesign:PackIcon Kind="Check" Width="16" Height="16"
                                                     Foreground="#4CAF50"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Интеграция с 1С:Предприятие" Foreground="#C8D8E8"
                                   FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Background="#2D4F72" Width="28" Height="28" CornerRadius="14" Margin="0,0,12,0">
                            <materialDesign:PackIcon Kind="Check" Width="16" Height="16"
                                                     Foreground="#4CAF50"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Расчёт зарплаты водителей, ведомости" Foreground="#C8D8E8"
                                   FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#2D4F72" Width="28" Height="28" CornerRadius="14" Margin="0,0,12,0">
                            <materialDesign:PackIcon Kind="Check" Width="16" Height="16"
                                                     Foreground="#4CAF50"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Карта маршрутов в реальном времени" Foreground="#C8D8E8"
                                   FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Разделитель -->
                <Separator Background="#2D4F72" Margin="0,24,0,24"/>

                <TextBlock Foreground="#4A6A8A" FontSize="11" TextWrapping="Wrap">
                    <Run Text="Коарев А.А.  |  Группа ПИ-123  |  ВлГУ"/>
                </TextBlock>
                <TextBlock Text="Научный рук.: Канаева Е.М." Foreground="#4A6A8A" FontSize="11"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
