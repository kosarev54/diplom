<Window x:Class="DispatcherARM.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="АРМ Диспетчера — Транспортно-логистическая компания"
        Width="1440" Height="860"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F0F2F5"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Стиль пункта меню -->
        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderThickness="3,0,0,0" BorderBrush="Transparent"
                                Padding="16,9">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E8EDF2"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D6E4F0"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1E3A5F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка шапки -->
        <Style x:Key="HeaderBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C8D8E8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D4F72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <!-- ══ ШАПКА ══ -->
        <Border Grid.ColumnSpan="2" Background="#1E3A5F">
            <DockPanel Margin="0,0,8,0">
                <!-- Логотип + название -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,20,0">
                    <materialDesign:PackIcon Kind="TruckDelivery" Width="20" Height="20"
                                             Foreground="#7BAFD4" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="АРМ Диспетчера" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                        <Run Text="  |  " Foreground="#4A6A8A" FontSize="13"/>
                        <Run Text="Транспортно-логистическая система" Foreground="#7BAFD4" FontSize="12"/>
                    </TextBlock>
                </StackPanel>

                <!-- Правая часть -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="Калькулятор маршрута" Click="Calculator_Click"
                            Style="{StaticResource HeaderBtnStyle}" Margin="0,0,4,0"/>
                    <Border Width="1" Background="#2D4F72" Margin="4,8"/>
                    <materialDesign:PackIcon Kind="Account" Width="16" Height="16"
                                             Foreground="#7BAFD4" VerticalAlignment="Center" Margin="8,0,4,0"/>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock x:Name="UserNameText" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock x:Name="UserRoleText" Foreground="#7BAFD4" FontSize="10"/>
                        <Button Content="Сменить пароль" Click="ChangePassword_Click"
                                Background="Transparent" Foreground="#93C5FD"
                                BorderThickness="0" FontSize="11" Cursor="Hand"
                                HorizontalAlignment="Left" Padding="0,2"/>
                    </StackPanel>
                    <Border Width="1" Background="#2D4F72" Margin="4,8"/>
                    <Button Content="Выход" Click="LogoutButton_Click"
                            Style="{StaticResource HeaderBtnStyle}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ══ БОКОВОЕ МЕНЮ ══ -->
        <Border Grid.Row="1" Background="White"
                BorderBrush="#D0D7DE" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Метка группы меню -->
                <Border DockPanel.Dock="Top" Padding="16,10,16,6" BorderBrush="#E8ECF0"
                        BorderThickness="0,0,0,1">
                    <TextBlock Text="НАВИГАЦИЯ" FontSize="10" FontWeight="Bold"
                               Foreground="#8A9BAE"/>
                </Border>

                <!-- Поддержка внизу -->
                <Border DockPanel.Dock="Bottom" BorderBrush="#E8ECF0" BorderThickness="0,1,0,0">
                    <ListBox SelectionChanged="MenuList_SelectionChanged" BorderThickness="0"
                             Background="Transparent">
                        <ListBoxItem x:Name="MenuSupport" Style="{StaticResource NavItemStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="HelpCircle" Width="16" Height="16"
                                                         VerticalAlignment="Center" Foreground="#6B7B8D" Margin="0,0,10,0"/>
                                <TextBlock Text="Справка и поддержка" FontSize="13" Foreground="#4A5568" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </Border>

                <!-- Основное меню -->
                <ListBox x:Name="MenuList" SelectionChanged="MenuList_SelectionChanged"
                         BorderThickness="0" Background="Transparent">

                    <ListBoxItem x:Name="MenuDashboard" Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ViewDashboard" Width="16" Height="16"
                                                     VerticalAlignment="Center" Foreground="#6B7B8D" Margin="0,0,10,0"/>
                            <TextBlock Text="Рабочий стол" FontSize="13" Foreground="#2D3748" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem x:Name="MenuOrders" Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ClipboardText" Width="16" Height="16"
                                                     VerticalAlignment="Center" Foreground="#6B7B8D" Margin="0,0,10,0"/>
                            <TextBlock Text="Заказы" FontSize="13" Foreground="#2D3748" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem x:Name="MenuDriverOrders" Visibility="Collapsed"
                                 Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Package" Width="16" Height="16"
                                                     VerticalAlignment="Center" Foreground="#6B7B8D" Margin="0,0,10,0"/>
                            <TextBlock Text="Мои заказы" FontSize="13" Foreground="#2D3748" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </ListBoxItem>

                    <!-- Разделитель -->
                    <ListBoxItem IsEnabled="False" Style="{StaticResource NavItemStyle}" Height="1"
                                 Background="#F0F2F5" Margin="0,4,0,4"/>

                    <ListBoxItem x:Name="MenuMap" Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Map" Width="16" Height="16"
                                                     VerticalAlignment="Center" Foreground="#6B7B8D" Margin="0,0,10,0"/>
                            <TextBlock Text="Карта маршрутов" FontSize="13" Foreground="#2D3748" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem x:Name="MenuRoutes" Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="MapMarkerPath" Width="16" Height="16"
                                                     VerticalAlignment="Center" Foreground="#6B7B8D" Margin="0,0,10,0"/>
                            <TextBlock Text="Маршруты" FontSize="13" Foreground="#2D3748" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>

                    <!-- Разделитель -->
                    <ListBoxItem IsEnabled="False" Style="{StaticResource NavItemStyle}" Height="1"
                                 Background="#F0F2F5" Margin="0,4,0,4"/>

                    <ListBoxItem x:Name="MenuDrivers" Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Account" Width="16" Height="16"
                                                     VerticalAlignment="Center" Foreground="#6B7B8D" Margin="0,0,10,0"/>
                            <TextBlock Text="Водители" FontSize="13" Foreground="#2D3748" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem x:Name="MenuVehicles" Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Truck" Width="16" Height="16"
                                                     VerticalAlignment="Center" Foreground="#6B7B8D" Margin="0,0,10,0"/>
                            <TextBlock Text="Транспорт" FontSize="13" Foreground="#2D3748" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>

                    <!-- Разделитель -->
                    <ListBoxItem IsEnabled="False" Style="{StaticResource NavItemStyle}" Height="1"
                                 Background="#F0F2F5" Margin="0,4,0,4"/>

                    <ListBoxItem x:Name="MenuReports" Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ChartBar" Width="16" Height="16"
                                                     VerticalAlignment="Center" Foreground="#6B7B8D" Margin="0,0,10,0"/>
                            <TextBlock Text="Отчёты и ведомости" FontSize="13" Foreground="#2D3748" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem x:Name="MenuWallet" Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Wallet" Width="16" Height="16"
                                                     VerticalAlignment="Center" Foreground="#6B7B8D" Margin="0,0,10,0"/>
                            <TextBlock Text="Мой кошелёк" FontSize="13" Foreground="#2D3748" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem x:Name="MenuAdminUsers" Visibility="Collapsed"
                                 Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountGroup" Width="16" Height="16"
                                                     VerticalAlignment="Center" Foreground="#6B7B8D" Margin="0,0,10,0"/>
                            <TextBlock Text="Пользователи" FontSize="13" Foreground="#2D3748" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>

                    <!-- Разделитель -->
                    <ListBoxItem IsEnabled="False" Style="{StaticResource NavItemStyle}" Height="1"
                                 Background="#F0F2F5" Margin="0,4,0,4"/>

                    <ListBoxItem x:Name="MenuIntegration" Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="SwapHorizontal" Width="16" Height="16"
                                                     VerticalAlignment="Center" Foreground="#6B7B8D" Margin="0,0,10,0"/>
                            <TextBlock Text="Интеграция 1С" FontSize="13" Foreground="#2D3748" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem x:Name="MenuClientPortal" Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Web" Width="16" Height="16"
                                                     VerticalAlignment="Center" Foreground="#6B7B8D" Margin="0,0,10,0"/>
                            <TextBlock Text="Портал клиентов" FontSize="13" Foreground="#2D3748" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem x:Name="MenuSettings" Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Cog" Width="16" Height="16"
                                                     VerticalAlignment="Center" Foreground="#6B7B8D" Margin="0,0,10,0"/>
                            <TextBlock Text="Настройки" FontSize="13" Foreground="#2D3748" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>

                </ListBox>
            </DockPanel>
        </Border>

        <!-- ══ РАБОЧАЯ ОБЛАСТЬ ══ -->
        <Border Grid.Row="1" Grid.Column="1" Background="#F0F2F5">
            <ContentControl x:Name="ContentArea" Margin="0"/>
        </Border>

        <!-- ══ СТАТУС-СТРОКА ══ -->
        <Border Grid.Row="2" Grid.ColumnSpan="2"
                Background="#1E3A5F"
                BorderThickness="0">
            <DockPanel Margin="12,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="#4CAF50" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="Подключено к БД" Foreground="#7BAFD4" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="  |  " Foreground="#2D4F72" FontSize="11"/>
                    <TextBlock x:Name="OrderCountText" Foreground="#7BAFD4" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="OsrmStatusText" Text="OSRM: публичный сервер"
                               Foreground="#4A6A8A" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="АРМ Диспетчера v2.0 — ВлГУ / 09.03.03"
                               Foreground="#4A6A8A" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
