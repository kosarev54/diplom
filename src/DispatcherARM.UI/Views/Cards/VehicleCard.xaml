<Window x:Class="DispatcherARM.UI.Views.Cards.VehicleCard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Карточка транспортного средства" Width="820" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        Loaded="VehicleCard_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <materialDesign:ColorZone Mode="PrimaryDark" Padding="20,16">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Truck" Width="56" Height="56"
                                             Foreground="White" VerticalAlignment="Center" Margin="0,0,20,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="VehicleTitleText" Text="ТС"
                                   Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                                   Foreground="White" FontWeight="Bold" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <materialDesign:PackIcon x:Name="StatusIcon" Kind="Circle" Width="12" Height="12"
                                                     Foreground="LightGreen" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock x:Name="StatusText" Text="Доступно" Foreground="#E0E0E0" VerticalAlignment="Center" />
                            <TextBlock Text=" · " Foreground="#E0E0E0" />
                            <TextBlock x:Name="TypeText" Text="" Foreground="#B0BEC5" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Метрики в шапке -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,24,0" HorizontalAlignment="Center">
                        <TextBlock x:Name="OdometerText" Text="0 км"
                                   Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                                   Foreground="White" HorizontalAlignment="Center" />
                        <TextBlock Text="Пробег" Foreground="#B0BEC5" FontSize="11" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Margin="0,0,24,0" HorizontalAlignment="Center">
                        <TextBlock x:Name="LastMaintText" Text="—"
                                   Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                                   Foreground="White" HorizontalAlignment="Center" />
                        <TextBlock Text="Посл. ТО" Foreground="#B0BEC5" FontSize="11" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="RoutesCountText" Text="0"
                                   Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                                   Foreground="White" HorizontalAlignment="Center" />
                        <TextBlock Text="Маршрутов" Foreground="#B0BEC5" FontSize="11" HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </materialDesign:ColorZone>

        <!-- Вкладки -->
        <TabControl Grid.Row="1" Style="{StaticResource MaterialDesignFilledTabControl}">

            <!-- Вкладка 1: Характеристики -->
            <TabItem Header="Характеристики">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <UniformGrid Columns="2" Margin="16">
                        <!-- Основные данные -->
                        <materialDesign:Card Padding="16" Margin="8">
                            <StackPanel>
                                <TextBlock Text="Основная информация" FontWeight="SemiBold"
                                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Margin="0,0,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Гос. номер:" Foreground="Gray" Margin="0,4" />
                                    <TextBlock x:Name="InfoPlate" Grid.Row="0" Grid.Column="1" Margin="0,4" FontWeight="Bold" FontSize="16" />
                                    <TextBlock Grid.Row="1" Text="Модель:" Foreground="Gray" Margin="0,4" />
                                    <TextBlock x:Name="InfoModel" Grid.Row="1" Grid.Column="1" Margin="0,4" />
                                    <TextBlock Grid.Row="2" Text="Год выпуска:" Foreground="Gray" Margin="0,4" />
                                    <TextBlock x:Name="InfoYear" Grid.Row="2" Grid.Column="1" Margin="0,4" />
                                    <TextBlock Grid.Row="3" Text="VIN:" Foreground="Gray" Margin="0,4" />
                                    <TextBlock x:Name="InfoVin" Grid.Row="3" Grid.Column="1" Margin="0,4" FontFamily="Consolas" />
                                    <TextBlock Grid.Row="4" Text="Тип:" Foreground="Gray" Margin="0,4" />
                                    <TextBlock x:Name="InfoType" Grid.Row="4" Grid.Column="1" Margin="0,4" />
                                    <TextBlock Grid.Row="5" Text="Статус:" Foreground="Gray" Margin="0,4" />
                                    <TextBlock x:Name="InfoStatus" Grid.Row="5" Grid.Column="1" Margin="0,4" />
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Характеристики -->
                        <materialDesign:Card Padding="16" Margin="8">
                            <StackPanel>
                                <TextBlock Text="Технические характеристики" FontWeight="SemiBold"
                                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Margin="0,0,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Грузоподъёмность:" Foreground="Gray" Margin="0,4" />
                                    <TextBlock x:Name="InfoWeight" Grid.Row="0" Grid.Column="1" Margin="0,4" />
                                    <TextBlock Grid.Row="1" Text="Объём кузова:" Foreground="Gray" Margin="0,4" />
                                    <TextBlock x:Name="InfoVolume" Grid.Row="1" Grid.Column="1" Margin="0,4" />
                                    <TextBlock Grid.Row="2" Text="Расход топлива:" Foreground="Gray" Margin="0,4" />
                                    <TextBlock x:Name="InfoFuel" Grid.Row="2" Grid.Column="1" Margin="0,4" />
                                    <TextBlock Grid.Row="3" Text="Пробег:" Foreground="Gray" Margin="0,4" />
                                    <TextBlock x:Name="InfoOdometer" Grid.Row="3" Grid.Column="1" Margin="0,4" FontWeight="Medium" />
                                    <TextBlock Grid.Row="4" Text="Страховка:" Foreground="Gray" Margin="0,4" />
                                    <TextBlock x:Name="InfoInsurance" Grid.Row="4" Grid.Column="1" Margin="0,4" />
                                    <TextBlock Grid.Row="5" Text="Стоимость/мес:" Foreground="Gray" Margin="0,4" />
                                    <TextBlock x:Name="InfoCost" Grid.Row="5" Grid.Column="1" Margin="0,4" />
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- ТО -->
                        <materialDesign:Card Padding="16" Margin="8" Grid.ColumnSpan="2">
                            <StackPanel>
                                <TextBlock Text="Техническое обслуживание" FontWeight="SemiBold"
                                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Margin="0,0,0,12" />
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#E8F5E9" CornerRadius="8" Padding="16,12" Margin="0,0,16,0">
                                        <StackPanel>
                                            <TextBlock x:Name="LastToDate" Text="—"
                                                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                                       Foreground="#2E7D32" HorizontalAlignment="Center" />
                                            <TextBlock Text="Дата последнего ТО" Foreground="Gray" FontSize="11" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#E3F2FD" CornerRadius="8" Padding="16,12" Margin="0,0,16,0">
                                        <StackPanel>
                                            <TextBlock x:Name="LastToOdometer" Text="—"
                                                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                                       Foreground="{DynamicResource PrimaryHueMidBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="Пробег на ТО" Foreground="Gray" FontSize="11" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="NextToCard" Background="#FFF8E1" CornerRadius="8" Padding="16,12" Margin="0,0,16,0">
                                        <StackPanel>
                                            <TextBlock x:Name="NextToDate" Text="—"
                                                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                                       Foreground="#F57F17" HorizontalAlignment="Center" />
                                            <TextBlock Text="Следующее ТО (дата)" Foreground="Gray" FontSize="11" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#FCE4EC" CornerRadius="8" Padding="16,12">
                                        <StackPanel>
                                            <TextBlock x:Name="NextToKm" Text="—"
                                                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                                       Foreground="#C62828" HorizontalAlignment="Center" />
                                            <TextBlock Text="Осталось до ТО (км)" Foreground="Gray" FontSize="11" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </materialDesign:Card>
                    </UniformGrid>
                </ScrollViewer>
            </TabItem>

            <!-- Вкладка 2: Водители и маршруты -->
            <TabItem Header="Последние рейсы">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Последний водитель -->
                    <materialDesign:Card Padding="16" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountCircle" Width="40" Height="40"
                                                     Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,12,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Последний водитель" Foreground="Gray" FontSize="11" />
                                <TextBlock x:Name="LastDriverText" Text="—" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock x:Name="LastRouteText" Text="—" Foreground="Gray" FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>

                    <TextBlock Grid.Row="1" Text="История рейсов"
                               Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Margin="0,0,0,8" />
                    <DataGrid x:Name="RoutesGrid" Grid.Row="2"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              materialDesign:DataGridAssist.CellPadding="8 4" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="90" />
                            <DataGridTextColumn Header="Водитель" Binding="{Binding Driver.FullName}" Width="150" />
                            <DataGridTextColumn Header="Маршрут" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Дистанция (км)" Binding="{Binding TotalDistanceKm, StringFormat=F1}" Width="110" />
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,8">
            <Button Content="Закрыть" IsCancel="True"
                    Style="{StaticResource MaterialDesignRaisedButton}" />
        </StackPanel>
    </Grid>
</Window>
