<Window x:Class="DispatcherARM.UI.Views.Cards.DriverCard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Карточка водителя" Width="820" Height="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        Loaded="DriverCard_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Шапка — фото + ФИО + статус -->
        <materialDesign:ColorZone Mode="PrimaryMid" Padding="20,16">
            <StackPanel Orientation="Horizontal">
                <!-- Аватар -->
                <Border Width="72" Height="72" CornerRadius="36"
                        Background="White" Margin="0,0,20,0">
                    <materialDesign:PackIcon Kind="AccountCircle" Width="64" Height="64"
                                             Foreground="{DynamicResource PrimaryHueMidBrush}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <!-- Имя и статус -->
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="DriverNameText" Text="Водитель"
                               Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                               Foreground="White" FontWeight="Bold" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <materialDesign:PackIcon x:Name="StatusIcon" Kind="Circle" Width="14" Height="14"
                                                 Foreground="LightGreen" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock x:Name="StatusText" Text="Доступен"
                                   Foreground="#E0E0E0" VerticalAlignment="Center" />
                        <TextBlock Text=" · " Foreground="#E0E0E0" />
                        <TextBlock x:Name="VehicleText" Text="Без ТС"
                                   Foreground="#E0E0E0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="PhoneText" Text=""
                               Foreground="#B0BEC5" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Быстрые метрики справа -->
                <StackPanel Orientation="Horizontal" Margin="40,0,0,0" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,24,0" HorizontalAlignment="Center">
                        <TextBlock x:Name="TotalRoutesText" Text="0"
                                   Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                                   Foreground="White" HorizontalAlignment="Center" />
                        <TextBlock Text="Маршрутов" Foreground="#B0BEC5" FontSize="11" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Margin="0,0,24,0" HorizontalAlignment="Center">
                        <TextBlock x:Name="TotalKmText" Text="0"
                                   Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                                   Foreground="White" HorizontalAlignment="Center" />
                        <TextBlock Text="км всего" Foreground="#B0BEC5" FontSize="11" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="SalaryText" Text="0 ₽"
                                   Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                                   Foreground="White" HorizontalAlignment="Center" />
                        <TextBlock Text="Оклад/мес" Foreground="#B0BEC5" FontSize="11" HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </materialDesign:ColorZone>

        <!-- Вкладки -->
        <TabControl Grid.Row="1" Style="{StaticResource MaterialDesignFilledTabControl}" Margin="0">

            <!-- Вкладка 1: Общая информация -->
            <TabItem Header="Основные данные">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <UniformGrid Columns="2" Margin="16">
                        <!-- Личные данные -->
                        <materialDesign:Card Padding="16" Margin="8">
                            <StackPanel>
                                <TextBlock Text="Личная информация" FontWeight="SemiBold"
                                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Margin="0,0,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="ФИО:" Foreground="Gray" Margin="0,4" />
                                    <TextBlock x:Name="InfoName" Grid.Row="0" Grid.Column="1" Margin="0,4" FontWeight="Medium" />
                                    <TextBlock Grid.Row="1" Text="Телефон:" Foreground="Gray" Margin="0,4" />
                                    <TextBlock x:Name="InfoPhone" Grid.Row="1" Grid.Column="1" Margin="0,4" />
                                    <TextBlock Grid.Row="2" Text="Email:" Foreground="Gray" Margin="0,4" />
                                    <TextBlock x:Name="InfoEmail" Grid.Row="2" Grid.Column="1" Margin="0,4" />
                                    <TextBlock Grid.Row="3" Text="Дата рождения:" Foreground="Gray" Margin="0,4" />
                                    <TextBlock x:Name="InfoBirth" Grid.Row="3" Grid.Column="1" Margin="0,4" />
                                    <TextBlock Grid.Row="4" Text="Адрес:" Foreground="Gray" Margin="0,4" />
                                    <TextBlock x:Name="InfoAddress" Grid.Row="4" Grid.Column="1" Margin="0,4" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="5" Text="Принят:" Foreground="Gray" Margin="0,4" />
                                    <TextBlock x:Name="InfoHireDate" Grid.Row="5" Grid.Column="1" Margin="0,4" />
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Лицензия и ТС -->
                        <materialDesign:Card Padding="16" Margin="8">
                            <StackPanel>
                                <TextBlock Text="Водительское удостоверение" FontWeight="SemiBold"
                                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Margin="0,0,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="26" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Номер ВУ:" Foreground="Gray" Margin="0,4" />
                                    <TextBlock x:Name="InfoLicense" Grid.Row="0" Grid.Column="1" Margin="0,4" FontWeight="Medium" />
                                    <TextBlock Grid.Row="1" Text="Категории:" Foreground="Gray" Margin="0,4" />
                                    <TextBlock x:Name="InfoCategories" Grid.Row="1" Grid.Column="1" Margin="0,4" />
                                    <TextBlock Grid.Row="2" Text="Действует до:" Foreground="Gray" Margin="0,4" />
                                    <TextBlock x:Name="InfoLicenseExpiry" Grid.Row="2" Grid.Column="1" Margin="0,4" />

                                    <Separator Grid.Row="3" Grid.ColumnSpan="2" Margin="0,4" />

                                    <TextBlock Grid.Row="4" Text="Текущее ТС:" Foreground="Gray" Margin="0,4" />
                                    <TextBlock x:Name="InfoVehicle" Grid.Row="4" Grid.Column="1" Margin="0,4" FontWeight="Medium" />
                                    <TextBlock Grid.Row="5" Text="График работы:" Foreground="Gray" Margin="0,4" />
                                    <TextBlock x:Name="InfoSchedule" Grid.Row="5" Grid.Column="1" Margin="0,4" />
                                    <TextBlock Grid.Row="6" Text="Примечания:" Foreground="Gray" Margin="0,4" />
                                    <TextBlock x:Name="InfoNotes" Grid.Row="6" Grid.Column="1" Margin="0,4" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Зарплата -->
                        <materialDesign:Card Padding="16" Margin="8" Grid.ColumnSpan="2">
                            <StackPanel>
                                <TextBlock Text="Оплата труда" FontWeight="SemiBold"
                                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Margin="0,0,0,12" />
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#E3F2FD" CornerRadius="8" Padding="16,12" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock x:Name="SalaryBaseText" Text="0 ₽"
                                                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                                       Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                            <TextBlock Text="Оклад в месяц" Foreground="Gray" FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#F3E5F5" CornerRadius="8" Padding="16,12" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock x:Name="RateKmText" Text="0 ₽/км"
                                                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                                       Foreground="#7B1FA2" />
                                            <TextBlock Text="Ставка за км" Foreground="Gray" FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#E8F5E9" CornerRadius="8" Padding="16,12" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock x:Name="RateDeliveryText" Text="0 ₽"
                                                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                                       Foreground="#2E7D32" />
                                            <TextBlock Text="За доставку" Foreground="Gray" FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#FFF8E1" CornerRadius="8" Padding="16,12">
                                        <StackPanel>
                                            <TextBlock x:Name="EstimatedMonthText" Text="0 ₽"
                                                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                                       Foreground="#F57F17" />
                                            <TextBlock Text="Расчётная (этот месяц)" Foreground="Gray" FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </materialDesign:Card>
                    </UniformGrid>
                </ScrollViewer>
            </TabItem>

            <!-- Вкладка 2: Маршруты -->
            <TabItem Header="История маршрутов">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Последние маршруты водителя"
                               Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Margin="0,0,0,8" />
                    <DataGrid x:Name="RoutesGrid" Grid.Row="1"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              materialDesign:DataGridAssist.CellPadding="8 4" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="90" />
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="ТС" Binding="{Binding Vehicle.LicensePlate}" Width="90" />
                            <DataGridTextColumn Header="Дистанция (км)" Binding="{Binding TotalDistanceKm, StringFormat=F1}" Width="110" />
                            <DataGridTextColumn Header="Время (мин)" Binding="{Binding TotalTimeMinutes, StringFormat=F0}" Width="95" />
                            <DataGridTextColumn Header="Точек" Binding="{Binding Waypoints.Count}" Width="60" />
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Вкладка 3: График работы -->
            <TabItem Header="График работы">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16">
                    <StackPanel>
                        <TextBlock Text="График работы на текущий месяц"
                                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Margin="0,0,0,16" />

                        <!-- Легенда -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="20" Height="20" Background="#4CAF50" CornerRadius="3" Margin="0,0,6,0" />
                            <TextBlock Text="Рабочий" Margin="0,0,16,0" VerticalAlignment="Center" />
                            <Border Width="20" Height="20" Background="#F44336" CornerRadius="3" Margin="0,0,6,0" />
                            <TextBlock Text="Выходной" Margin="0,0,16,0" VerticalAlignment="Center" />
                            <Border Width="20" Height="20" Background="#2196F3" CornerRadius="3" Margin="0,0,6,0" />
                            <TextBlock Text="В рейсе" Margin="0,0,16,0" VerticalAlignment="Center" />
                            <Border Width="20" Height="20" Background="#9E9E9E" CornerRadius="3" Margin="0,0,6,0" />
                            <TextBlock Text="Будущий" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Календарь-сетка -->
                        <ItemsControl x:Name="CalendarGrid">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="48" Height="48" Margin="2" CornerRadius="6"
                                            Background="{Binding DayColor}"
                                            ToolTip="{Binding Tooltip}">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Day}" FontWeight="Bold"
                                                       Foreground="White" HorizontalAlignment="Center" FontSize="14" />
                                            <TextBlock Text="{Binding DayOfWeek}" Foreground="#E0E0E0"
                                                       HorizontalAlignment="Center" FontSize="9" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Margin="0,16" />

                        <!-- Статистика месяца -->
                        <TextBlock Text="Статистика за текущий месяц"
                                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#E8F5E9" CornerRadius="8" Padding="16,10" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock x:Name="WorkDaysText" Text="0"
                                               Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                               Foreground="#2E7D32" HorizontalAlignment="Center" />
                                    <TextBlock Text="Рабочих дней" Foreground="Gray" FontSize="11" />
                                </StackPanel>
                            </Border>
                            <Border Background="#FFEBEE" CornerRadius="8" Padding="16,10" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock x:Name="OffDaysText" Text="0"
                                               Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                               Foreground="#C62828" HorizontalAlignment="Center" />
                                    <TextBlock Text="Выходных" Foreground="Gray" FontSize="11" />
                                </StackPanel>
                            </Border>
                            <Border Background="#E3F2FD" CornerRadius="8" Padding="16,10">
                                <StackPanel>
                                    <TextBlock x:Name="MonthKmText" Text="0 км"
                                               Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                               Foreground="{DynamicResource PrimaryHueMidBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Пробег за месяц" Foreground="Gray" FontSize="11" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Нижние кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="16,8" >
            <Button Content="Редактировать" Click="Edit_Click"
                    Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0" />
            <Button Content="Закрыть" IsCancel="True"
                    Style="{StaticResource MaterialDesignRaisedButton}" />
        </StackPanel>
    </Grid>
</Window>
