<Window x:Class="DispatcherARM.UI.Views.Cards.RouteCard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Карточка маршрута" Width="820" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        Loaded="RouteCard_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <materialDesign:ColorZone Mode="PrimaryMid" Padding="20,16">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Routes" Width="48" Height="48"
                                             Foreground="White" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="RouteTitleText" Text="Маршрут"
                                   Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                                   Foreground="White" FontWeight="Bold" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock x:Name="RouteDriverText" Text="—"
                                       Foreground="#E0E0E0" VerticalAlignment="Center" />
                            <TextBlock Text=" · " Foreground="#E0E0E0" />
                            <TextBlock x:Name="RouteVehicleText" Text="—"
                                       Foreground="#B0BEC5" VerticalAlignment="Center" />
                            <TextBlock Text=" · " Foreground="#E0E0E0" />
                            <TextBlock x:Name="RouteDateText" Text="—"
                                       Foreground="#B0BEC5" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Метрики -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock x:Name="DistanceText" Text="0 км"
                                   Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                                   Foreground="White" HorizontalAlignment="Center" />
                        <TextBlock Text="Дистанция" Foreground="#B0BEC5" FontSize="11" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock x:Name="TimeText" Text="0 мин"
                                   Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                                   Foreground="White" HorizontalAlignment="Center" />
                        <TextBlock Text="Время" Foreground="#B0BEC5" FontSize="11" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock x:Name="FuelText" Text="0 л"
                                   Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                                   Foreground="White" HorizontalAlignment="Center" />
                        <TextBlock Text="Расход топлива" Foreground="#B0BEC5" FontSize="11" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="RevenueText" Text="0 ₽"
                                   Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                                   Foreground="White" HorizontalAlignment="Center" />
                        <TextBlock Text="Выручка" Foreground="#B0BEC5" FontSize="11" HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </materialDesign:ColorZone>

        <!-- Вкладки -->
        <TabControl Grid.Row="1" Style="{StaticResource MaterialDesignFilledTabControl}">

            <!-- Вкладка 1: Детали маршрута -->
            <TabItem Header="Информация">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <UniformGrid Columns="2" Margin="16">
                        <!-- Основные данные -->
                        <materialDesign:Card Padding="16" Margin="8">
                            <StackPanel>
                                <TextBlock Text="Параметры маршрута" FontWeight="SemiBold"
                                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Margin="0,0,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Дата:" Foreground="Gray" Margin="0,4" />
                                    <TextBlock x:Name="InfoDate" Grid.Row="0" Grid.Column="1" Margin="0,4" FontWeight="Medium" />
                                    <TextBlock Grid.Row="1" Text="Статус:" Foreground="Gray" Margin="0,4" />
                                    <TextBlock x:Name="InfoStatus" Grid.Row="1" Grid.Column="1" Margin="0,4" />
                                    <TextBlock Grid.Row="2" Text="Дистанция:" Foreground="Gray" Margin="0,4" />
                                    <TextBlock x:Name="InfoDistance" Grid.Row="2" Grid.Column="1" Margin="0,4" />
                                    <TextBlock Grid.Row="3" Text="Время в пути:" Foreground="Gray" Margin="0,4" />
                                    <TextBlock x:Name="InfoTime" Grid.Row="3" Grid.Column="1" Margin="0,4" />
                                    <TextBlock Grid.Row="4" Text="Алгоритм:" Foreground="Gray" Margin="0,4" />
                                    <TextBlock x:Name="InfoAlgorithm" Grid.Row="4" Grid.Column="1" Margin="0,4" />
                                    <TextBlock Grid.Row="5" Text="Топливо (расч.):" Foreground="Gray" Margin="0,4" />
                                    <TextBlock x:Name="InfoFuelCalc" Grid.Row="5" Grid.Column="1" Margin="0,4" />
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Водитель и ТС -->
                        <materialDesign:Card Padding="16" Margin="8">
                            <StackPanel>
                                <TextBlock Text="Исполнитель" FontWeight="SemiBold"
                                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Margin="0,0,0,12" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <materialDesign:PackIcon Kind="AccountCircle" Width="40" Height="40"
                                                             Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,12,0" />
                                    <StackPanel>
                                        <TextBlock Text="Водитель" Foreground="Gray" FontSize="11" />
                                        <TextBlock x:Name="InfoDriver" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock x:Name="InfoDriverPhone" Foreground="Gray" />
                                    </StackPanel>
                                </StackPanel>
                                <Separator Margin="0,4,0,12" />
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Truck" Width="40" Height="40"
                                                             Foreground="#546E7A" Margin="0,0,12,0" />
                                    <StackPanel>
                                        <TextBlock Text="Транспортное средство" Foreground="Gray" FontSize="11" />
                                        <TextBlock x:Name="InfoVehicle" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock x:Name="InfoVehicleType" Foreground="Gray" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Финансы -->
                        <materialDesign:Card Padding="16" Margin="8" Grid.ColumnSpan="2">
                            <StackPanel>
                                <TextBlock Text="Финансовые показатели" FontWeight="SemiBold"
                                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Margin="0,0,0,12" />
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#E8F5E9" CornerRadius="8" Padding="16,12" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock x:Name="FinRevenue" Text="0 ₽"
                                                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                                       Foreground="#2E7D32" HorizontalAlignment="Center" />
                                            <TextBlock Text="Выручка с доставок" Foreground="Gray" FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#FCE4EC" CornerRadius="8" Padding="16,12" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock x:Name="FinFuelCost" Text="0 ₽"
                                                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                                       Foreground="#C62828" HorizontalAlignment="Center" />
                                            <TextBlock Text="Стоимость топлива" Foreground="Gray" FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#E3F2FD" CornerRadius="8" Padding="16,12">
                                        <StackPanel>
                                            <TextBlock x:Name="FinProfit" Text="0 ₽"
                                                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                                       Foreground="{DynamicResource PrimaryHueMidBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="Прибыль (без ЗП)" Foreground="Gray" FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </materialDesign:Card>
                    </UniformGrid>
                </ScrollViewer>
            </TabItem>

            <!-- Вкладка 2: Точки доставки -->
            <TabItem Header="Точки доставки">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="WaypointSummary" Text="Точки доставки"
                               Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Margin="0,0,0,8" />
                    <DataGrid x:Name="WaypointsGrid" Grid.Row="1"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              materialDesign:DataGridAssist.CellPadding="8 4" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding SequenceNumber}" Width="40" />
                            <DataGridTextColumn Header="Клиент" Binding="{Binding Order.ClientName}" Width="140" />
                            <DataGridTextColumn Header="Адрес" Binding="{Binding Order.Address}" Width="*" />
                            <DataGridTextColumn Header="Вес (кг)" Binding="{Binding Order.Weight, StringFormat=F0}" Width="70" />
                            <DataGridTextColumn Header="Цена" Binding="{Binding Order.DeliveryPrice, StringFormat=N0}" Width="80" />
                            <DataGridTextColumn Header="Оплата" Binding="{Binding Order.CashOnDelivery, StringFormat=N0}" Width="80" />
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100" />
                            <DataGridTextColumn Header="Прибытие" Binding="{Binding EstimatedArrival, StringFormat=HH:mm}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,8">
            <Button Content="Закрыть" IsCancel="True"
                    Style="{StaticResource MaterialDesignRaisedButton}" />
        </StackPanel>
    </Grid>
</Window>
