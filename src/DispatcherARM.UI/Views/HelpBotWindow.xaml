<Window x:Class="DispatcherARM.UI.Views.HelpBotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="🛟 Поддержка — АРМ Диспетчера"
        MinWidth="440" MinHeight="520"
        Width="520" Height="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F0F4F8">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />    <!-- шапка -->
            <RowDefinition Height="*" />        <!-- чат (вся оставшаяся высота) -->
            <RowDefinition Height="Auto" />    <!-- быстрые вопросы -->
            <RowDefinition Height="Auto" />    <!-- поле ввода -->
        </Grid.RowDefinitions>

        <!-- ══ Шапка ══ -->
        <Border Background="#1565C0" Padding="16,14">
            <StackPanel Orientation="Horizontal">
                <Border Background="#FFFFFF30" CornerRadius="24"
                        Width="48" Height="48" Margin="0,0,14,0">
                    <TextBlock Text="🤖" FontSize="24"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="АРМ-Помощник" FontWeight="Bold"
                               Foreground="White" FontSize="17" />
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#69F0AE"
                                 VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Онлайн • Отвечает мгновенно"
                                   Foreground="#B3E5FC" FontSize="11" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ══ Область чата (ScrollViewer занимает всю оставшуюся высоту) ══ -->
        <ScrollViewer x:Name="ChatScroll"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="#F0F4F8"
                      Padding="12,10"
                      CanContentScroll="False">
            <ItemsControl x:Name="ChatList">
                <!-- Важно: панель растягивается по ширине -->
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,5">
                            <!-- Бот: аватар слева + пузырёк -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Left"
                                        Visibility="{Binding IsBot, Converter={StaticResource BoolToVisibilityConverter}}">
                                <!-- Аватар бота -->
                                <Border Background="#1565C0" CornerRadius="16"
                                        Width="32" Height="32"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="🤖" FontSize="14"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <!-- Пузырёк бота (белый, с тенью) -->
                                <Border Background="White"
                                        CornerRadius="4,18,18,18"
                                        Padding="14,10"
                                        MaxWidth="330">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.08"
                                                          BlurRadius="8" ShadowDepth="2" />
                                    </Border.Effect>
                                    <TextBlock Text="{Binding Text}"
                                               TextWrapping="Wrap"
                                               FontSize="13"
                                               Foreground="#1A1A1A"
                                               LineHeight="22" />
                                </Border>
                            </StackPanel>

                            <!-- Пользователь: пузырёк справа -->
                            <Border Background="#1565C0"
                                    CornerRadius="18,4,18,18"
                                    Padding="14,10"
                                    MaxWidth="300"
                                    HorizontalAlignment="Right"
                                    Visibility="{Binding IsUser, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#1565C0" Opacity="0.3"
                                                      BlurRadius="8" ShadowDepth="2" />
                                </Border.Effect>
                                <TextBlock Text="{Binding Text}"
                                           TextWrapping="Wrap"
                                           Foreground="White"
                                           FontSize="13"
                                           LineHeight="22" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ══ Быстрые вопросы ══ -->
        <Border Grid.Row="2" Background="White"
                BorderBrush="#D0D7DE" BorderThickness="0,1,0,0"
                Padding="12,10">
            <StackPanel>
                <TextBlock Text="Частые вопросы:" Foreground="#6B7280"
                           FontSize="11" FontWeight="Medium" Margin="0,0,0,7" />
                <WrapPanel>
                    <Button Content="📦 Создать заказ" Tag="order" Click="QuickQ_Click"
                            Background="#EFF6FF" Foreground="#1D4ED8"
                            BorderBrush="#BFDBFE" BorderThickness="1"
                            Padding="10,5" Margin="0,0,5,5" FontSize="11" Cursor="Hand" />
                    <Button Content="🗺️ Маршрут" Tag="route" Click="QuickQ_Click"
                            Background="#F0FDF4" Foreground="#16A34A"
                            BorderBrush="#BBF7D0" BorderThickness="1"
                            Padding="10,5" Margin="0,0,5,5" FontSize="11" Cursor="Hand" />
                    <Button Content="💳 Вывести деньги" Tag="money" Click="QuickQ_Click"
                            Background="#FFF7ED" Foreground="#C2410C"
                            BorderBrush="#FED7AA" BorderThickness="1"
                            Padding="10,5" Margin="0,0,5,5" FontSize="11" Cursor="Hand" />
                    <Button Content="👥 Роли" Tag="roles" Click="QuickQ_Click"
                            Background="#FAF5FF" Foreground="#7C3AED"
                            BorderBrush="#DDD6FE" BorderThickness="1"
                            Padding="10,5" Margin="0,0,5,5" FontSize="11" Cursor="Hand" />
                    <Button Content="✅ Выполнение" Tag="complete" Click="QuickQ_Click"
                            Background="#F0FDFA" Foreground="#0F766E"
                            BorderBrush="#99F6E4" BorderThickness="1"
                            Padding="10,5" FontSize="11" Cursor="Hand" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ══ Поле ввода ══ -->
        <Border Grid.Row="3" Background="White"
                BorderBrush="#D0D7DE" BorderThickness="0,1,0,0"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Background="#F8FAFC" CornerRadius="24"
                        BorderBrush="#D0D7DE" BorderThickness="1"
                        Padding="16,0" Margin="0,0,10,0" Height="42">
                    <TextBox x:Name="InputBox"
                             Background="Transparent" BorderThickness="0"
                             materialDesign:HintAssist.Hint="Напишите вопрос..."
                             FontSize="13" VerticalAlignment="Center"
                             KeyDown="Input_KeyDown" />
                </Border>

                <Button Content="➤" Click="Send_Click" Grid.Column="1"
                        Width="42" Height="42"
                        Background="#1565C0" Foreground="White"
                        BorderThickness="0"
                        FontSize="18" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="21"
                                    Width="{TemplateBinding Width}"
                                    Height="{TemplateBinding Height}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
