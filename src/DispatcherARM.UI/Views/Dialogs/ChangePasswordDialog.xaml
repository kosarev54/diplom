<Window x:Class="DispatcherARM.UI.Views.Dialogs.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Смена пароля" Width="360" Height="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F0F2F5"
        FontFamily="Segoe UI">

    <StackPanel Margin="24">
        <!-- Заголовок -->
        <TextBlock Text="Смена пароля" FontSize="16" FontWeight="SemiBold"
                   Foreground="#1E3A5F" Margin="0,0,0,20"/>

        <TextBlock Text="Текущий пароль" FontSize="12" Foreground="#374151" Margin="0,0,0,4"/>
        <PasswordBox x:Name="CurrentPasswordBox" Padding="8,6"
                     BorderBrush="#D1D5DB" BorderThickness="1" Margin="0,0,0,12"/>

        <TextBlock Text="Новый пароль" FontSize="12" Foreground="#374151" Margin="0,0,0,4"/>
        <PasswordBox x:Name="NewPasswordBox" Padding="8,6"
                     BorderBrush="#D1D5DB" BorderThickness="1" Margin="0,0,0,12"/>

        <TextBlock Text="Повторите новый пароль" FontSize="12" Foreground="#374151" Margin="0,0,0,4"/>
        <PasswordBox x:Name="ConfirmPasswordBox" Padding="8,6"
                     BorderBrush="#D1D5DB" BorderThickness="1" Margin="0,0,0,16"/>

        <TextBlock x:Name="ErrorText" Foreground="#C0392B" FontSize="11"
                   TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" Click="Cancel_Click"
                    Height="32" Padding="16,0" Margin="0,0,8,0" Cursor="Hand"
                    Background="White" BorderBrush="#D1D5DB" BorderThickness="1"/>
            <Button Content="Сохранить" Click="Save_Click"
                    Height="32" Padding="16,0" Cursor="Hand"
                    Background="#1E3A5F" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </StackPanel>
</Window>
