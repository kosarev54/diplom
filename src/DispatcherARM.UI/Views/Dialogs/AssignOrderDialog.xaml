<Window x:Class="DispatcherARM.UI.Views.Dialogs.AssignOrderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Назначить водителя и ТС" Width="560" Height="460"
        MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource MaterialDesign.Brush.Background}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Background="#3F51B5" Padding="20,14">
            <StackPanel>
                <TextBlock Text="Назначение заказа" Foreground="White"
                           FontSize="18" FontWeight="Bold"/>
                <TextBlock x:Name="OrderInfoText" Foreground="#C5CAE9"
                           FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Содержимое -->
        <StackPanel Grid.Row="1" Margin="24,20">

            <!-- Водитель -->
            <TextBlock Text="ВОДИТЕЛЬ" FontSize="11" FontWeight="Bold"
                       Foreground="#6B7280" Margin="0,0,0,8"/>
            <ComboBox x:Name="DriverBox"
                      materialDesign:HintAssist.Hint="Выберите водителя *"
                      materialDesign:HintAssist.IsFloating="True"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      DisplayMemberPath="DisplayText"
                      SelectionChanged="DriverBox_SelectionChanged"
                      Margin="0,0,0,16"/>

            <!-- Инфо о выбранном водителе -->
            <Border x:Name="DriverInfoBorder" Visibility="Collapsed"
                    Background="#EFF6FF" CornerRadius="8" Padding="14,10"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Телефон:" Foreground="Gray" FontSize="11"/>
                        <TextBlock x:Name="DriverPhoneText" FontWeight="Medium"/>
                        <TextBlock Text="График:" Foreground="Gray" FontSize="11" Margin="0,6,0,0"/>
                        <TextBlock x:Name="DriverScheduleText"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Статус:" Foreground="Gray" FontSize="11"/>
                        <TextBlock x:Name="DriverStatusText" FontWeight="Medium"/>
                        <TextBlock Text="Текущее ТС:" Foreground="Gray" FontSize="11" Margin="0,6,0,0"/>
                        <TextBlock x:Name="DriverVehicleText"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ТС -->
            <TextBlock Text="ТРАНСПОРТНОЕ СРЕДСТВО" FontSize="11" FontWeight="Bold"
                       Foreground="#6B7280" Margin="0,0,0,8"/>
            <ComboBox x:Name="VehicleBox"
                      materialDesign:HintAssist.Hint="Выберите ТС *"
                      materialDesign:HintAssist.IsFloating="True"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      DisplayMemberPath="DisplayText"
                      Margin="0,0,0,16"/>

            <!-- Дата доставки -->
            <TextBlock Text="ДАТА ДОСТАВКИ" FontSize="11" FontWeight="Bold"
                       Foreground="#6B7280" Margin="0,0,0,8"/>
            <DatePicker x:Name="DeliveryDatePicker"
                        materialDesign:HintAssist.Hint="Дата доставки"
                        materialDesign:HintAssist.IsFloating="True"
                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                        Margin="0,0,0,8"/>

            <TextBlock x:Name="ErrorText" Foreground="#E53935"
                       Visibility="Collapsed" Margin="0,4,0,0" FontSize="12"/>
        </StackPanel>

        <!-- Кнопки -->
        <Border Grid.Row="2" Background="White"
                BorderBrush="#E8EAF0" BorderThickness="0,1,0,0"
                Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" IsCancel="True"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Margin="0,0,8,0"/>
                <Button Content="✅ Назначить" Click="Assign_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
