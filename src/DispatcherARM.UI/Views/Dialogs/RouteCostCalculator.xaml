<Window x:Class="DispatcherARM.UI.Views.Dialogs.RouteCostCalculator"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Калькулятор стоимости маршрута"
        MinWidth="480" MinHeight="520"
        Width="520" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource MaterialDesign.Brush.Background}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <materialDesign:PackIcon Kind="Calculator" Width="36" Height="36"
                                         Foreground="{DynamicResource PrimaryHueMidBrush}"
                                         VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Text="Калькулятор стоимости маршрута"
                           Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Параметры маршрута -->
            <GroupBox Header="Параметры маршрута" Margin="0,0,0,16"
                      Style="{StaticResource MaterialDesignCardGroupBox}">
                <StackPanel Margin="8">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DistanceBox" Text="50"
                                 materialDesign:HintAssist.Hint="Дистанция (км)"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 TextChanged="Recalculate" />
                        <TextBox x:Name="DeliveriesBox" Text="5" Grid.Column="2"
                                 materialDesign:HintAssist.Hint="Кол-во доставок"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 TextChanged="Recalculate" />
                    </Grid>
                    <TextBox x:Name="WeightBox" Text="500"
                             materialDesign:HintAssist.Hint="Общий вес груза (кг)"
                             materialDesign:HintAssist.IsFloating="True"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             TextChanged="Recalculate" />
                </StackPanel>
            </GroupBox>

            <!-- Тарифы -->
            <GroupBox Header="Тарифы (редактируемые)" Margin="0,0,0,16"
                      Style="{StaticResource MaterialDesignCardGroupBox}">
                <StackPanel Margin="8">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FuelPriceBox" Text="55"
                                 materialDesign:HintAssist.Hint="Цена топлива (₽/л)"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 TextChanged="Recalculate" />
                        <TextBox x:Name="FuelConsBox" Text="12" Grid.Column="2"
                                 materialDesign:HintAssist.Hint="Расход (л/100 км)"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 TextChanged="Recalculate" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DriverRateKmBox" Text="2"
                                 materialDesign:HintAssist.Hint="Ставка водителя (₽/км)"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 TextChanged="Recalculate" />
                        <TextBox x:Name="DriverRateDelivBox" Text="150" Grid.Column="2"
                                 materialDesign:HintAssist.Hint="Ставка за доставку (₽)"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 TextChanged="Recalculate" />
                    </Grid>
                    <TextBox x:Name="OverheadBox" Text="10"
                             materialDesign:HintAssist.Hint="Накладные расходы (%)"
                             materialDesign:HintAssist.IsFloating="True"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             TextChanged="Recalculate" />
                </StackPanel>
            </GroupBox>

            <!-- Результат -->
            <materialDesign:Card Padding="16" Background="#E8F5E9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="FuelCostText" Text="0 ₽"
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                   Foreground="#E65100" HorizontalAlignment="Center" />
                        <TextBlock Text="Топливо" Foreground="Gray" FontSize="11" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock x:Name="LaborCostText" Text="0 ₽"
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                   Foreground="#1565C0" HorizontalAlignment="Center" />
                        <TextBlock Text="Работа водителя" Foreground="Gray" FontSize="11" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock x:Name="TotalCostText" Text="0 ₽"
                                   Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                                   Foreground="#2E7D32" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Text="ИТОГО" Foreground="Gray" FontSize="11" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Закрыть" IsCancel="True"
                        Style="{StaticResource MaterialDesignRaisedButton}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
