<Window x:Class="DispatcherARM.UI.Views.Dialogs.ImportCsvDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Импорт заказов из CSV" Width="740" Height="580"
        MinWidth="520" MinHeight="440"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource MaterialDesign.Brush.Background}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Background="#3F51B5" Padding="20,14">
            <StackPanel>
                <TextBlock Text="📥 Импорт заказов из CSV" Foreground="White"
                           FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="Загрузите файл CSV для массового добавления заказов в систему"
                           Foreground="#C5CAE9" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
            <StackPanel>
                <!-- Формат файла -->
                <Border Background="#FFFBEB" CornerRadius="8" Padding="14,12"
                        Margin="0,0,0,16" BorderBrush="#FDE68A" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="📋 Формат CSV-файла (разделитель — точка с запятой):"
                                   FontWeight="Bold" Foreground="#92400E" Margin="0,0,0,6"/>
                        <TextBlock FontFamily="Courier New" FontSize="11" Foreground="#92400E"
                                   Text="ClientName;ClientPhone;Address;Latitude;Longitude;Weight;Volume;DeliveryPrice;CashOnDelivery;Priority;Notes"/>
                        <TextBlock FontFamily="Courier New" FontSize="11" Foreground="#92400E" Margin="0,3,0,0"
                                   Text="ООО Альфа;+7(495)100-10-01;Москва,Тверская,1;55.7558;37.6173;50;0.5;1500;0;Normal;Хрупкое"/>
                        <TextBlock FontSize="11" Foreground="#78350F" Margin="0,6,0,0"
                                   Text="Priority: Low | Normal | High | Urgent. Первая строка — заголовок (пропускается). Координаты — необязательны (0;0 → автоопределение)."/>
                    </StackPanel>
                </Border>

                <!-- Выбор файла -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="📂 Выбрать CSV файл" Click="SelectFile_Click"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#3F51B5" Foreground="White"
                            materialDesign:ButtonAssist.CornerRadius="6" Margin="0,0,12,0"/>
                    <Button Content="📄 Скачать шаблон" Click="DownloadTemplate_Click"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            materialDesign:ButtonAssist.CornerRadius="6"/>
                </StackPanel>

                <TextBlock x:Name="FilePathText" Foreground="Gray" FontSize="12"
                           Text="Файл не выбран" Margin="0,0,0,12"/>

                <!-- Предпросмотр -->
                <TextBlock x:Name="PreviewHeader" Visibility="Collapsed"
                           FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                <DataGrid x:Name="PreviewGrid" Visibility="Collapsed"
                          AutoGenerateColumns="True" IsReadOnly="True"
                          MaxHeight="200" CanUserAddRows="False"
                          materialDesign:DataGridAssist.CellPadding="6 3"
                          Margin="0,0,0,12"/>

                <!-- Результат -->
                <Border x:Name="ResultBorder" Visibility="Collapsed"
                        CornerRadius="8" Padding="14,10">
                    <TextBlock x:Name="ResultText" TextWrapping="Wrap" FontSize="13"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Нижняя панель -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E8EAF0"
                BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" IsCancel="True"
                        Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"/>
                <Button x:Name="ImportBtn" Content="✅ Импортировать" Click="Import_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}" IsEnabled="False"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
