<Window x:Class="DispatcherARM.UI.Views.Dialogs.TtnDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Товарно-транспортная накладная (ТТН)" Width="900" Height="760"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#F0F2F5" FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#6B7B8D"/>
            <Setter Property="Margin" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#1A2332"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SecHeader" TargetType="Border">
            <Setter Property="Background" Value="#2D4F72"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,8,0,6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Background="#1E3A5F" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock x:Name="TtnNumberText" Foreground="White" FontSize="14" FontWeight="Bold"/>
                    <TextBlock x:Name="TtnDateText" Foreground="#7BAFD4" FontSize="11"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ТОВАРНО-ТРАНСПОРТНАЯ НАКЛАДНАЯ" Foreground="White"
                               FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="Форма  1-Т  |  Унифицированная форма" Foreground="#7BAFD4" FontSize="10"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Содержимое -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="White">
            <StackPanel Margin="20,12,20,12">

                <!-- Раздел 1: Стороны -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Грузоотправитель -->
                    <Border BorderBrush="#D0D7DE" BorderThickness="1" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="ГРУЗООТПРАВИТЕЛЬ" FontSize="10" FontWeight="Bold"
                                       Foreground="#1E3A5F" Margin="0,0,0,6"/>
                            <TextBlock Text="Наименование:" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="ShipperNameText" Style="{StaticResource FieldValue}"/>
                            <TextBlock Text="Адрес:" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="ShipperAddressText" Style="{StaticResource FieldValue}"/>
                            <TextBlock Text="Телефон:" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="ShipperPhoneText" Style="{StaticResource FieldValue}"/>
                        </StackPanel>
                    </Border>

                    <!-- Грузополучатель -->
                    <Border Grid.Column="2" BorderBrush="#D0D7DE" BorderThickness="1" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="ГРУЗОПОЛУЧАТЕЛЬ" FontSize="10" FontWeight="Bold"
                                       Foreground="#1E3A5F" Margin="0,0,0,6"/>
                            <TextBlock Text="Наименование:" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="ReceiverNameText" Style="{StaticResource FieldValue}"/>
                            <TextBlock Text="Адрес:" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="ReceiverAddressText" Style="{StaticResource FieldValue}"/>
                            <TextBlock Text="Телефон:" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="ReceiverPhoneText" Style="{StaticResource FieldValue}"/>
                        </StackPanel>
                    </Border>

                    <!-- Перевозчик -->
                    <Border Grid.Column="4" BorderBrush="#D0D7DE" BorderThickness="1" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="ПЕРЕВОЗЧИК" FontSize="10" FontWeight="Bold"
                                       Foreground="#1E3A5F" Margin="0,0,0,6"/>
                            <TextBlock Text="Наименование:" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="CarrierNameText" Style="{StaticResource FieldValue}"/>
                            <TextBlock Text="Водитель:" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="DriverNameText" Style="{StaticResource FieldValue}"/>
                            <TextBlock Text="ТС / Гос. номер:" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="VehicleText" Style="{StaticResource FieldValue}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Раздел: Пункты -->
                <Border Style="{StaticResource SecHeader}">
                    <TextBlock Text="СВЕДЕНИЯ О ПЕРЕВОЗКЕ" Foreground="White" FontSize="10" FontWeight="Bold"/>
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Пункт погрузки:" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="LoadingPointText" Style="{StaticResource FieldValue}"/>
                        <TextBlock Text="Дата и время погрузки:" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="LoadingTimeText" Style="{StaticResource FieldValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Пункт разгрузки:" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="UnloadingPointText" Style="{StaticResource FieldValue}"/>
                        <TextBlock Text="Дата и время разгрузки:" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="UnloadingTimeText" Style="{StaticResource FieldValue}"/>
                    </StackPanel>
                </Grid>

                <!-- Товарный раздел -->
                <Border Style="{StaticResource SecHeader}">
                    <TextBlock Text="ТОВАРНЫЙ РАЗДЕЛ (Перечень товарно-материальных ценностей)"
                               Foreground="White" FontSize="10" FontWeight="Bold"/>
                </Border>

                <!-- Таблица товаров -->
                <DataGrid x:Name="ItemsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" HeadersVisibility="Column"
                          GridLinesVisibility="All" BorderThickness="1" BorderBrush="#D0D7DE"
                          RowHeight="24" FontSize="11" Background="White"
                          HorizontalGridLinesBrush="#E8ECF0"
                          VerticalGridLinesBrush="#E8ECF0">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F4F5F7"/>
                            <Setter Property="Foreground" Value="#4A5568"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="10"/>
                            <Setter Property="Padding" Value="6,3"/>
                            <Setter Property="BorderBrush" Value="#D0D7DE"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№" Width="30"
                                            Binding="{Binding RowNumber}"/>
                        <DataGridTextColumn Header="Наименование товара"
                                            Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Арт." Width="70"
                                            Binding="{Binding ArticleNumber}"/>
                        <DataGridTextColumn Header="Кол-во"
                                            Binding="{Binding Quantity, StringFormat=F2}" Width="60"/>
                        <DataGridTextColumn Header="Ед. изм."
                                            Binding="{Binding Unit}" Width="55"/>
                        <DataGridTextColumn Header="Цена, ₽"
                                            Binding="{Binding UnitPrice, StringFormat=N2}" Width="80"/>
                        <DataGridTextColumn Header="Сумма, ₽"
                                            Binding="{Binding TotalPrice, StringFormat=N2}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Итого -->
                <Border BorderBrush="#D0D7DE" BorderThickness="0,0,1,1" Background="#F7F9FC">
                    <Grid Margin="6,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="TotalInWordsText" FontSize="11"
                                       Foreground="#4A5568" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="Итого без НДС:" FontSize="11" Foreground="#6B7B8D"/>
                            <TextBlock x:Name="TotalExVatText" FontSize="12" FontWeight="Bold"/>
                            <TextBlock Text="НДС (20%):" FontSize="11" Foreground="#6B7B8D"/>
                            <TextBlock x:Name="VatText" FontSize="12"/>
                            <TextBlock Text="ИТОГО с НДС:" FontSize="12" FontWeight="Bold"
                                       Foreground="#1E3A5F"/>
                            <TextBlock x:Name="TotalText" FontSize="14" FontWeight="Bold"
                                       Foreground="#1E3A5F"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Транспортный раздел -->
                <Border Style="{StaticResource SecHeader}">
                    <TextBlock Text="ТРАНСПОРТНЫЙ РАЗДЕЛ" Foreground="White"
                               FontSize="10" FontWeight="Bold"/>
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Масса груза (по заказу), кг:" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="WeightText" Style="{StaticResource FieldValue}"/>
                        <TextBlock Text="Масса груза (факт), кг:" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="____________________" Style="{StaticResource FieldValue}"
                                   Foreground="#9CA3AF"/>
                        <TextBlock Text="Откуда:" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="RouteFromText" Style="{StaticResource FieldValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Стоимость перевозки, ₽:" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="DeliveryPriceText" Style="{StaticResource FieldValue}"/>
                        <TextBlock Text="Вид упаковки:" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="Согласно заказу" Style="{StaticResource FieldValue}"/>
                        <TextBlock Text="Куда:" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="RouteToText" Style="{StaticResource FieldValue}"/>
                    </StackPanel>
                </Grid>

                <!-- Подписи -->
                <Border Style="{StaticResource SecHeader}">
                    <TextBlock Text="ПОДПИСИ СТОРОН" Foreground="White"
                               FontSize="10" FontWeight="Bold"/>
                </Border>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border BorderBrush="#D0D7DE" BorderThickness="1" Padding="8,8">
                        <StackPanel>
                            <TextBlock Text="Грузоотправитель:" FontSize="10" FontWeight="Bold"
                                       Foreground="#6B7B8D" Margin="0,0,0,20"/>
                            <Separator Background="#D0D7DE" Margin="0,0,0,2"/>
                            <TextBlock Text="подпись / расшифровка" FontSize="9" Foreground="#CBD5E0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" BorderBrush="#D0D7DE" BorderThickness="1" Padding="8,8">
                        <StackPanel>
                            <TextBlock Text="Водитель-экспедитор:" FontSize="10" FontWeight="Bold"
                                       Foreground="#6B7B8D" Margin="0,0,0,20"/>
                            <Separator Background="#D0D7DE" Margin="0,0,0,2"/>
                            <TextBlock Text="подпись / расшифровка" FontSize="9" Foreground="#CBD5E0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" BorderBrush="#D0D7DE" BorderThickness="1" Padding="8,8">
                        <StackPanel>
                            <TextBlock Text="Грузополучатель:" FontSize="10" FontWeight="Bold"
                                       Foreground="#6B7B8D" Margin="0,0,0,20"/>
                            <Separator Background="#D0D7DE" Margin="0,0,0,2"/>
                            <TextBlock Text="подпись / М.П." FontSize="9" Foreground="#CBD5E0"/>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки -->
        <Border Grid.Row="2" Background="#F7F9FC" BorderBrush="#D0D7DE"
                BorderThickness="0,1,0,0" Padding="16,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                           FontSize="11" Foreground="#6B7B8D"
                           Text="Унифицированная форма 1-Т  |  Постановление Госкомстата РФ №78"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Сохранить в RTF" Click="SaveToWord_Click"
                            Height="30" Padding="14,0" FontSize="12" Margin="0,0,8,0"
                            Background="#1E3A5F" Foreground="White" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        CornerRadius="3" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#2D4F72"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="Печать" Click="Print_Click"
                            Height="30" Padding="14,0" FontSize="12" Margin="0,0,8,0"
                            Background="White" BorderBrush="#CBD5E0" BorderThickness="1" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="3" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#EBF4FF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="Закрыть" IsCancel="True"
                            Height="30" Padding="14,0" FontSize="12"
                            Background="White" BorderBrush="#CBD5E0" BorderThickness="1" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="3" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
