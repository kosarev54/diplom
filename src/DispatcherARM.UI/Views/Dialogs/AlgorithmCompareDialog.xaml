<Window x:Class="DispatcherARM.UI.Views.Dialogs.AlgorithmCompareDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сравнение алгоритмов маршрутизации" Width="960" Height="700"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#F5F7FA">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>

        <!-- ── Шапка ───────────────────────────────────────────────────────── -->
        <Border Background="#1E3A5F">
            <StackPanel VerticalAlignment="Center" Margin="20,0">
                <TextBlock Text="Сравнение алгоритмов маршрутизации"
                           Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Научная часть диплома — анализ качества оптимизации"
                           Foreground="#93C5FD" FontSize="11"/>
            </StackPanel>
        </Border>

        <!-- ── Панель параметров ────────────────────────────────────────────── -->
        <Border Grid.Row="1" Background="White" BorderBrush="#DDE2EC" BorderThickness="0,0,0,1"
                Padding="20,14">
            <StackPanel>
                <TextBlock Text="ПАРАМЕТРЫ ЭКСПЕРИМЕНТА" FontSize="11" FontWeight="Bold"
                           Foreground="#6B7280" Margin="0,0,0,10"/>
                <WrapPanel>
                    <!-- Транспортное средство -->
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="Транспортное средство" FontSize="12" Foreground="#374151" Margin="0,0,0,4"/>
                        <ComboBox x:Name="VehicleCombo" Width="220" Height="30"
                                  DisplayMemberPath="DisplayName"/>
                    </StackPanel>

                    <!-- Набор заказов -->
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="Набор заказов" FontSize="12" Foreground="#374151" Margin="0,0,0,4"/>
                        <ComboBox x:Name="OrderSetCombo" Width="200" Height="30"
                                  SelectionChanged="OrderSetCombo_SelectionChanged">
                            <ComboBoxItem Content="Все активные заказы" Tag="all" IsSelected="True"/>
                            <ComboBoxItem Content="Последние 10 заказов" Tag="10"/>
                            <ComboBoxItem Content="Последние 20 заказов" Tag="20"/>
                            <ComboBoxItem Content="Последние 50 заказов" Tag="50"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Количество заказов -->
                    <StackPanel VerticalAlignment="Bottom" Margin="0,0,24,0">
                        <TextBlock x:Name="OrderCountText" FontSize="13" Foreground="#1E3A5F"
                                   FontWeight="SemiBold" Text="Заказов: —"/>
                    </StackPanel>

                    <!-- Кнопка запуска -->
                    <Button x:Name="RunBtn" Content="▶ Запустить сравнение"
                            Height="34" Padding="18,0"
                            Background="#1E3A5F" Foreground="White" BorderThickness="0"
                            Cursor="Hand" Click="RunComparison_Click"
                            VerticalAlignment="Bottom"/>

                    <Button x:Name="ExportBtn" Content="Экспорт в CSV"
                            Height="34" Padding="12,0" Margin="8,0,0,0"
                            Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                            Cursor="Hand" Click="Export_Click" IsEnabled="False"
                            VerticalAlignment="Bottom"/>
                </WrapPanel>

                <!-- Прогресс -->
                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,10,0,0">
                    <ProgressBar x:Name="ProgressBar" Height="4" IsIndeterminate="True"
                                 Background="#E5E7EB" Foreground="#1E3A5F"/>
                    <TextBlock x:Name="ProgressText" FontSize="11" Foreground="#6B7280"
                               Margin="0,4,0,0" Text="Выполняется оптимизация..."/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── Таблица результатов ──────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="20,16">
            <StackPanel>
                <!-- Таблица сравнения -->
                <Border Background="White" BorderBrush="#DDE2EC" BorderThickness="1"
                        CornerRadius="4" Margin="0,0,0,16">
                    <StackPanel>
                        <Border Background="#1E3A5F" Padding="16,10">
                            <TextBlock Text="РЕЗУЛЬТАТЫ СРАВНЕНИЯ АЛГОРИТМОВ"
                                       Foreground="White" FontSize="12" FontWeight="Bold"/>
                        </Border>
                        <DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="All"
                                  AlternatingRowBackground="#F8FAFC"
                                  RowBackground="White"
                                  BorderThickness="0"
                                  ColumnHeaderHeight="36">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F1F5F9"/>
                                    <Setter Property="Foreground" Value="#374151"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Padding" Value="12,0"/>
                                    <Setter Property="BorderBrush" Value="#DDE2EC"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="12,6"/>
                                    <Setter Property="BorderBrush" Value="#E5E7EB"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#DBEAFE"/>
                                            <Setter Property="Foreground" Value="#1E3A5F"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Алгоритм"       Binding="{Binding AlgorithmName}" Width="220"/>
                                <DataGridTextColumn Header="Маршрут (км)"   Binding="{Binding DistanceKm}"    Width="120"/>
                                <DataGridTextColumn Header="Время (мин)"    Binding="{Binding TimeMinutes}"   Width="120"/>
                                <DataGridTextColumn Header="Заказов"        Binding="{Binding OrderCount}"    Width="90"/>
                                <DataGridTextColumn Header="Топливо (л)"    Binding="{Binding FuelLiters}"    Width="110"/>
                                <DataGridTextColumn Header="Время расч. (мс)" Binding="{Binding CalcMs}"     Width="130"/>
                                <DataGridTextColumn Header="Откл. от лучш." Binding="{Binding DeviationPct}" Width="130"/>
                                <DataGridTextColumn Header="Статус"         Binding="{Binding Status}"       Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Вывод / интерпретация -->
                <Border x:Name="SummaryBorder" Background="White" BorderBrush="#DDE2EC"
                        BorderThickness="1" CornerRadius="4" Margin="0,0,0,16"
                        Visibility="Collapsed">
                    <StackPanel>
                        <Border Background="#064E3B" Padding="16,10">
                            <TextBlock Text="ИНТЕРПРЕТАЦИЯ РЕЗУЛЬТАТОВ"
                                       Foreground="White" FontSize="12" FontWeight="Bold"/>
                        </Border>
                        <TextBlock x:Name="SummaryText" FontSize="13" Foreground="#1F2937"
                                   TextWrapping="Wrap" Padding="16,14" LineHeight="22"/>
                    </StackPanel>
                </Border>

                <!-- Сценарии для диплома -->
                <Border Background="White" BorderBrush="#DDE2EC" BorderThickness="1"
                        CornerRadius="4" Margin="0,0,0,16">
                    <StackPanel>
                        <Border Background="#1E40AF" Padding="16,10">
                            <TextBlock Text="ТЕСТОВЫЕ СЦЕНАРИИ ДЛЯ ДИПЛОМА"
                                       Foreground="White" FontSize="12" FontWeight="Bold"/>
                        </Border>
                        <StackPanel Margin="16,12">
                            <TextBlock FontSize="12" Foreground="#374151" TextWrapping="Wrap"
                                       Text="Для экспериментальной главы рекомендуется провести эксперименты на следующих наборах:"/>
                            <DataGrid x:Name="ScenariosGrid" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserAddRows="False"
                                      BorderThickness="1" BorderBrush="#DDE2EC"
                                      GridLinesVisibility="All" Margin="0,10,0,0"
                                      HeadersVisibility="Column" MaxHeight="200">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#F1F5F9"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="Padding" Value="10,4"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Сценарий"        Binding="{Binding Name}"       Width="160"/>
                                    <DataGridTextColumn Header="Заказов"         Binding="{Binding N}"          Width="80"/>
                                    <DataGridTextColumn Header="Описание"        Binding="{Binding Desc}"       Width="*"/>
                                    <DataGridTextColumn Header="Ожидаемый итог"  Binding="{Binding Expected}"   Width="250"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ── Нижняя строка статуса ───────────────────────────────────────── -->
        <Border Grid.Row="3" Background="#F1F5F9" BorderBrush="#DDE2EC"
                BorderThickness="0,1,0,0" Padding="20,8">
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="#6B7280"
                       Text="Выберите ТС, набор заказов и нажмите «Запустить сравнение»"/>
        </Border>

        <!-- ── Кнопка закрытия ─────────────────────────────────────────────── -->
        <Border Grid.Row="4" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
            <Button Content="Закрыть" IsCancel="True" Width="100" Height="34"
                    HorizontalAlignment="Right" Margin="0,0,20,0"
                    Background="White" BorderBrush="#D1D5DB" BorderThickness="1" Cursor="Hand"/>
        </Border>
    </Grid>
</Window>
