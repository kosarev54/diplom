<Window x:Class="DispatcherARM.UI.Views.Dialogs.CompleteOrderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Отметить выполнение заказа" Width="480" Height="420"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource MaterialDesign.Brush.Background}">
    <StackPanel Margin="24">
        <!-- Иконка + заголовок -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <materialDesign:PackIcon Kind="CheckCircle" Width="36" Height="36"
                                     Foreground="#4CAF50" VerticalAlignment="Center" Margin="0,0,12,0" />
            <StackPanel>
                <TextBlock Text="Подтверждение доставки"
                           Style="{StaticResource MaterialDesignHeadline6TextBlock}" />
                <TextBlock x:Name="OrderInfoText" Foreground="Gray" FontSize="12" />
            </StackPanel>
        </StackPanel>

        <!-- Инфо-карточка -->
        <materialDesign:Card Padding="12" Margin="0,0,0,16" materialDesign:ElevationAssist.Elevation="Dp1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Клиент:" Foreground="Gray" Margin="0,3" />
                <TextBlock x:Name="ClientText" Grid.Row="0" Grid.Column="1" Margin="0,3" FontWeight="Medium" />
                <TextBlock Grid.Row="1" Text="Адрес:" Foreground="Gray" Margin="0,3" />
                <TextBlock x:Name="AddressText" Grid.Row="1" Grid.Column="1" Margin="0,3" TextWrapping="Wrap" />
                <TextBlock Grid.Row="2" Text="Цена доставки:" Foreground="Gray" Margin="0,3" />
                <TextBlock x:Name="PriceText" Grid.Row="2" Grid.Column="1" Margin="0,3" Foreground="#2E7D32" FontWeight="Bold" />
                <TextBlock Grid.Row="3" Text="Наложенный платёж:" Foreground="Gray" Margin="0,3" />
                <TextBlock x:Name="CodText" Grid.Row="3" Grid.Column="1" Margin="0,3" Foreground="#C62828" FontWeight="Bold" />
            </Grid>
        </materialDesign:Card>

        <!-- Способ оплаты -->
        <TextBlock Text="Способ оплаты" FontWeight="Medium" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <RadioButton x:Name="PayCash" Content="Наличные" IsChecked="True"
                         GroupName="PayType" Margin="0,0,16,0"
                         Style="{StaticResource MaterialDesignRadioButton}" />
            <RadioButton x:Name="PayCard" Content="Карта / Безналичные"
                         GroupName="PayType"
                         Style="{StaticResource MaterialDesignRadioButton}" />
        </StackPanel>

        <!-- Принята ли оплата -->
        <CheckBox x:Name="PaidCheck" Content="Оплата получена от клиента"
                  IsChecked="True" Margin="0,0,0,8"
                  Style="{StaticResource MaterialDesignCheckBox}" />

        <!-- Примечание -->
        <TextBox x:Name="NoteBox"
                 materialDesign:HintAssist.Hint="Примечание (необязательно)"
                 materialDesign:HintAssist.IsFloating="True"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 Margin="0,0,0,16" />

        <TextBlock x:Name="ErrorText" Foreground="Red" Margin="0,0,0,8" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" IsCancel="True"
                    Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0" />
            <Button x:Name="ConfirmBtn" Content="✓ Подтвердить доставку"
                    Click="Confirm_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#4CAF50" BorderBrush="#4CAF50" />
        </StackPanel>
    </StackPanel>
</Window>
