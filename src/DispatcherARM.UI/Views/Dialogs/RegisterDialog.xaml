<Window x:Class="DispatcherARM.UI.Views.Dialogs.RegisterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Регистрация нового аккаунта"
        MinWidth="420" MinHeight="540"
        Width="460" Height="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource MaterialDesign.Brush.Background}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32">
            <materialDesign:PackIcon Kind="AccountPlus" Width="56" Height="56"
                                     HorizontalAlignment="Center"
                                     Foreground="{DynamicResource PrimaryHueMidBrush}"
                                     Margin="0,0,0,12" />
            <TextBlock Text="Регистрация"
                       Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                       HorizontalAlignment="Center" Margin="0,0,0,4" />
            <TextBlock Text="Аккаунт будет активирован после подтверждения администратором"
                       TextWrapping="Wrap" HorizontalAlignment="Center"
                       Foreground="Gray" FontSize="11" Margin="0,0,0,24" TextAlignment="Center" />

            <TextBox x:Name="FullNameBox"
                     materialDesign:HintAssist.Hint="Полное имя *"
                     materialDesign:HintAssist.IsFloating="True"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Margin="0,0,0,12" />

            <TextBox x:Name="LoginBox"
                     materialDesign:HintAssist.Hint="Логин (латиница, без пробелов) *"
                     materialDesign:HintAssist.IsFloating="True"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Margin="0,0,0,12" />

            <PasswordBox x:Name="PasswordBox"
                         materialDesign:HintAssist.Hint="Пароль (минимум 6 символов) *"
                         materialDesign:HintAssist.IsFloating="True"
                         Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                         Margin="0,0,0,12" />

            <PasswordBox x:Name="PasswordBox2"
                         materialDesign:HintAssist.Hint="Повторите пароль *"
                         materialDesign:HintAssist.IsFloating="True"
                         Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                         Margin="0,0,0,12" />

            <TextBox x:Name="EmailBox"
                     materialDesign:HintAssist.Hint="Email (необязательно)"
                     materialDesign:HintAssist.IsFloating="True"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Margin="0,0,0,12" />

            <TextBox x:Name="PhoneBox"
                     materialDesign:HintAssist.Hint="Телефон (необязательно)"
                     materialDesign:HintAssist.IsFloating="True"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Margin="0,0,0,16" />

            <ComboBox x:Name="RoleBox"
                      materialDesign:HintAssist.Hint="Запрашиваемая роль *"
                      materialDesign:HintAssist.IsFloating="True"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      Margin="0,0,0,16">
                <ComboBoxItem Content="Диспетчер" IsSelected="True" />
                <ComboBoxItem Content="Водитель" />
            </ComboBox>

            <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap"
                       Visibility="Collapsed" Margin="0,0,0,8" />

            <Button x:Name="RegisterBtn" Content="Отправить заявку на регистрацию"
                    Click="Register_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    HorizontalAlignment="Stretch" Height="44" Margin="0,0,0,8" />
            <Button Content="Отмена" IsCancel="True"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    HorizontalAlignment="Stretch" />
        </StackPanel>
    </ScrollViewer>
</Window>
