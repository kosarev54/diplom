<Window x:Class="DispatcherARM.UI.Views.Dialogs.BuildRouteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Построение маршрута" Width="750" Height="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        Loaded="Dialog_Loaded">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Построение оптимального маршрута"
                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                   Margin="0,0,0,16" />

        <!-- Список заказов для включения -->
        <GroupBox Grid.Row="1" Header="Выберите заказы для маршрута" Margin="0,0,0,12"
                  Style="{StaticResource MaterialDesignCardGroupBox}">
            <DataGrid x:Name="OrdersGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      SelectionMode="Extended"
                      materialDesign:DataGridAssist.CellPadding="6 2"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="40" />
                    <DataGridTextColumn Header="№" Binding="{Binding Order.OrderNumber}" Width="80" IsReadOnly="True" />
                    <DataGridTextColumn Header="Клиент" Binding="{Binding Order.ClientName}" Width="140" IsReadOnly="True" />
                    <DataGridTextColumn Header="Адрес" Binding="{Binding Order.Address}" Width="*" IsReadOnly="True" />
                    <DataGridTextColumn Header="Вес" Binding="{Binding Order.Weight, StringFormat=F0}" Width="55" IsReadOnly="True" />
                    <DataGridTextColumn Header="Приоритет" Binding="{Binding Order.Priority}" Width="80" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Водитель + ТС + Алгоритм -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <ComboBox x:Name="DriverBox" Width="200"
                      materialDesign:HintAssist.Hint="Водитель"
                      materialDesign:HintAssist.IsFloating="True"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      DisplayMemberPath="FullName" Margin="0,0,12,0" />

            <ComboBox x:Name="VehicleBox" Width="200"
                      materialDesign:HintAssist.Hint="Транспорт"
                      materialDesign:HintAssist.IsFloating="True"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      DisplayMemberPath="LicensePlate" Margin="0,0,12,0" />

            <ComboBox x:Name="AlgorithmBox" Width="220"
                      materialDesign:HintAssist.Hint="Алгоритм"
                      materialDesign:HintAssist.IsFloating="True"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}" />
        </StackPanel>

        <!-- Результат -->
        <Border Grid.Row="3" Background="#F5F5F5" CornerRadius="4" Padding="12" Margin="0,0,0,12"
                Visibility="{Binding ResultVisible}">
            <StackPanel x:Name="ResultPanel" Visibility="Collapsed">
                <TextBlock x:Name="ResultText" TextWrapping="Wrap"
                           Style="{StaticResource MaterialDesignBody1TextBlock}" />
            </StackPanel>
        </Border>

        <!-- Кнопки -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock x:Name="ErrorText" Foreground="Red" VerticalAlignment="Center"
                       Margin="0,0,12,0" />
            <ProgressBar x:Name="Progress" Style="{StaticResource MaterialDesignCircularProgressBar}"
                         IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,12,0" />
            <Button Content="Отмена" IsCancel="True"
                    Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0" />
            <Button x:Name="BuildButton" Content="Построить маршрут" Click="BuildButton_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}" />
        </StackPanel>
    </Grid>
</Window>
