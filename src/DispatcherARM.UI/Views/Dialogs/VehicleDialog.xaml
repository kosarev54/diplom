<Window x:Class="DispatcherARM.UI.Views.Dialogs.VehicleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Транспорт" Width="450" Height="480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource MaterialDesign.Brush.Background}">
    <StackPanel Margin="24">
        <TextBlock Text="Новое ТС" Style="{StaticResource MaterialDesignHeadline6TextBlock}" Margin="0,0,0,20" />
        <TextBox x:Name="PlateBox" materialDesign:HintAssist.Hint="Гос. номер *"
                 materialDesign:HintAssist.IsFloating="True"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12" />
        <TextBox x:Name="ModelBox" materialDesign:HintAssist.Hint="Модель *"
                 materialDesign:HintAssist.IsFloating="True"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12" />
        <ComboBox x:Name="TypeBox" materialDesign:HintAssist.Hint="Тип ТС"
                  materialDesign:HintAssist.IsFloating="True"
                  Style="{StaticResource MaterialDesignOutlinedComboBox}" SelectedIndex="1" Margin="0,0,0,12">
            <ComboBoxItem Content="Легковой" />
            <ComboBoxItem Content="Фургон" />
            <ComboBoxItem Content="Грузовик" />
            <ComboBoxItem Content="Рефрижератор" />
        </ComboBox>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBox x:Name="WeightBox" Width="180" materialDesign:HintAssist.Hint="Грузоподъёмность (кг)"
                     materialDesign:HintAssist.IsFloating="True"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,12,0" />
            <TextBox x:Name="VolumeBox" Width="180" materialDesign:HintAssist.Hint="Объём (м³)"
                     materialDesign:HintAssist.IsFloating="True"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" />
        </StackPanel>
        <TextBox x:Name="FuelBox" materialDesign:HintAssist.Hint="Расход (л/100км)"
                 materialDesign:HintAssist.IsFloating="True"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12" />
        <TextBlock x:Name="ErrorText" Foreground="Red" Margin="0,0,0,12" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" IsCancel="True"
                    Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0" />
            <Button Content="Сохранить" Click="Save_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}" />
        </StackPanel>
    </StackPanel>
</Window>
