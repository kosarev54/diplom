<Window x:Class="DispatcherARM.UI.Views.Dialogs.WebServerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Веб-форма для клиентов" Width="560" Height="460"
        MinWidth="440" MinHeight="360"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Background="#3F51B5" Padding="20,14">
            <StackPanel>
                <TextBlock Text="🌐 Веб-форма для клиентов" Foreground="White"
                           FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="Клиенты заполняют форму в браузере — заказ сразу появляется в системе"
                           Foreground="#C5CAE9" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="28,22">
            <!-- Индикатор статуса -->
            <Border x:Name="StatusBorder" CornerRadius="10" Padding="18,14" Margin="0,0,0,18">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="14" Height="14"
                             VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText" FontWeight="Bold" FontSize="15"/>
                        <TextBlock x:Name="StatusUrl" FontSize="12" Margin="0,2,0,0"
                                   Foreground="#4B5563"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Кнопки управления -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Button x:Name="StartBtn" Content="▶ Запустить" Click="StartServer_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="#2E7D32" Foreground="White"
                        materialDesign:ButtonAssist.CornerRadius="6"
                        Margin="0,0,10,0"/>
                <Button x:Name="StopBtn" Content="⏹ Остановить" Click="StopServer_Click"
                        IsEnabled="False"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Foreground="#C62828" BorderBrush="#C62828"
                        Margin="0,0,10,0"/>
                <Button Content="🌐 Открыть форму" Click="OpenBrowser_Click"
                        Style="{StaticResource MaterialDesignOutlinedButton}"/>
            </StackPanel>

            <!-- Лог заявок -->
            <TextBlock Text="ВХОДЯЩИЕ ЗАЯВКИ" FontSize="11" FontWeight="Bold"
                       Foreground="#6B7280" Margin="0,0,0,8"/>
            <Border BorderBrush="#E8EAF0" BorderThickness="1" CornerRadius="8"
                    Padding="12" Height="140">
                <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto"
                              CanContentScroll="False">
                    <TextBlock x:Name="LogText" TextWrapping="Wrap"
                               FontFamily="Courier New" FontSize="11"
                               Foreground="#374151"
                               Text="Запустите сервер — заявки будут появляться здесь в реальном времени..."/>
                </ScrollViewer>
            </Border>

            <TextBlock Margin="0,12,0,0" Foreground="Gray" FontSize="11" TextWrapping="Wrap"
                       Text="💡 Поделитесь ссылкой http://localhost:5050 с клиентами. Заявки сразу появляются в разделе «Заказы» со статусом «Новый»."/>
        </StackPanel>

        <Border Grid.Row="2" Background="White" BorderBrush="#E8EAF0"
                BorderThickness="0,1,0,0" Padding="20,12">
            <Button Content="Закрыть" IsCancel="True"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    HorizontalAlignment="Right"/>
        </Border>
    </Grid>
</Window>
