<Window x:Class="DispatcherARM.UI.Views.Dialogs.WaybillDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Путевой лист" Width="760" Height="720"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#F0F2F5" FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#6B7B8D"/>
            <Setter Property="Margin" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#1A2332"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="Border">
            <Setter Property="Background" Value="#1E3A5F"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,10,0,8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Background="#1E3A5F" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="WaybillNumberText" Foreground="White"
                               FontSize="15" FontWeight="Bold"/>
                    <TextBlock x:Name="IssueDateText" Foreground="#7BAFD4" FontSize="11"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ПУТЕВОЙ ЛИСТ" Foreground="White" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="Форма согласно Приказу Минтранса РФ №152" Foreground="#7BAFD4" FontSize="10"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Содержимое -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="White">
            <StackPanel Margin="20,14,20,14">

                <!-- Секция 1: Организация -->
                <Border Style="{StaticResource SectionHeader}">
                    <TextBlock Text="1. ОРГАНИЗАЦИЯ-ВЛАДЕЛЕЦ ТС" Foreground="White"
                               FontSize="11" FontWeight="Bold"/>
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Наименование:" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="OrganizationText" Style="{StaticResource FieldValue}"/>
                        <TextBlock Text="ИНН / КПП:" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="InnText" Style="{StaticResource FieldValue}"/>
                        <TextBlock Text="ОГРН:" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="OgrnText" Style="{StaticResource FieldValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Юридический адрес:" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="OrgAddressText" Style="{StaticResource FieldValue}"/>
                        <TextBlock Text="Телефон:" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="OrgPhoneText" Style="{StaticResource FieldValue}"/>
                    </StackPanel>
                </Grid>

                <!-- Секция 2: ТС -->
                <Border Style="{StaticResource SectionHeader}">
                    <TextBlock Text="2. ТРАНСПОРТНОЕ СРЕДСТВО" Foreground="White"
                               FontSize="11" FontWeight="Bold"/>
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Марка, модель:" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="VehicleBrandText" Style="{StaticResource FieldValue}"/>
                        <TextBlock Text="Государственный номер:" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="VehiclePlateText" Style="{StaticResource FieldValue}"
                                   FontSize="14" FontWeight="Bold"/>
                        <TextBlock Text="VIN:" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="VehicleVinText" Style="{StaticResource FieldValue}"/>
                        <TextBlock Text="Вид ТС:" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="VehicleTypeText" Style="{StaticResource FieldValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Вид топлива:" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="FuelTypeText" Style="{StaticResource FieldValue}"/>
                        <TextBlock Text="Показания одометра при выезде (км):" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="OdometerStartText" Style="{StaticResource FieldValue}"/>
                        <TextBlock Text="Показания одометра при возврате (км):" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="OdometerEndText" Style="{StaticResource FieldValue}"/>
                        <TextBlock Text="Горючее при выезде (л):" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="FuelStartText" Style="{StaticResource FieldValue}"/>
                        <TextBlock Text="Выдано горючего (л):" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="FuelGivenText" Style="{StaticResource FieldValue}"/>
                        <TextBlock Text="Остаток при возврате (л):" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="FuelEndText" Style="{StaticResource FieldValue}"/>
                    </StackPanel>
                </Grid>

                <!-- Секция 3: Водитель -->
                <Border Style="{StaticResource SectionHeader}">
                    <TextBlock Text="3. ВОДИТЕЛЬ" Foreground="White"
                               FontSize="11" FontWeight="Bold"/>
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="ФИО водителя:" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="DriverNameText" Style="{StaticResource FieldValue}"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Серия ВУ:" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="LicenseSeriesText" Style="{StaticResource FieldValue}"/>
                        <TextBlock Text="Номер ВУ:" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="LicenseNumberText" Style="{StaticResource FieldValue}"/>
                        <TextBlock Text="Категории:" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="LicenseCatText" Style="{StaticResource FieldValue}"/>
                        <TextBlock Text="Телефон:" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="DriverPhoneText" Style="{StaticResource FieldValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Border Background="#F0FDF4" BorderBrush="#A7F3D0" BorderThickness="1"
                                CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Медицинский предрейсовый осмотр:"
                                           FontSize="11" Foreground="#166534"/>
                                <TextBlock x:Name="MedCheckText" FontSize="12"
                                           FontWeight="SemiBold" Foreground="#166534"/>
                                <TextBlock Text="Медработник: _____________________"
                                           FontSize="11" Foreground="#6B7B8D" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                                CornerRadius="4" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="Технический осмотр ТС перед выездом:"
                                           FontSize="11" Foreground="#1E40AF"/>
                                <TextBlock x:Name="TechCheckText" FontSize="12"
                                           FontWeight="SemiBold" Foreground="#1E40AF"/>
                                <TextBlock Text="Механик: _________________________"
                                           FontSize="11" Foreground="#6B7B8D" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Секция 4: Маршрут -->
                <Border Style="{StaticResource SectionHeader}">
                    <TextBlock Text="4. МАРШРУТ ДВИЖЕНИЯ" Foreground="White"
                               FontSize="11" FontWeight="Bold"/>
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Пункт отправления:" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="PointFromText" Style="{StaticResource FieldValue}"/>
                        <TextBlock Text="Пункт назначения:" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="PointToText" Style="{StaticResource FieldValue}"/>
                    </StackPanel>
                    <Grid Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Выезд (план):" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="DeparturePlanText" Style="{StaticResource FieldValue}"/>
                            <TextBlock Text="Прибытие (план):" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="ArrivalPlanText" Style="{StaticResource FieldValue}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Выезд (факт):" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="DeparturFactText" Style="{StaticResource FieldValue}"
                                       Foreground="#9CA3AF"/>
                            <TextBlock Text="Прибытие (факт):" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="ArrivalFactText" Style="{StaticResource FieldValue}"
                                       Foreground="#9CA3AF"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Секция 5: Задание -->
                <Border Style="{StaticResource SectionHeader}">
                    <TextBlock Text="5. ЗАДАНИЕ НА ПЕРЕВОЗКУ" Foreground="White"
                               FontSize="11" FontWeight="Bold"/>
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Номер заказа:" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="OrderNumText" Style="{StaticResource FieldValue}"
                                   FontWeight="Bold" FontSize="13"/>
                        <TextBlock Text="Грузополучатель:" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="ClientText" Style="{StaticResource FieldValue}"/>
                        <TextBlock Text="Наименование груза:" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="CargoText" Style="{StaticResource FieldValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Масса груза:" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="WeightText" Style="{StaticResource FieldValue}"/>
                        <TextBlock Text="Объём груза (м³):" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="VolumeText" Style="{StaticResource FieldValue}"/>
                    </StackPanel>
                </Grid>

                <!-- Подписи -->
                <Border Style="{StaticResource SectionHeader}">
                    <TextBlock Text="6. ПОДПИСИ" Foreground="White"
                               FontSize="11" FontWeight="Bold"/>
                </Border>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Диспетчер (выдал задание):" FontSize="11" Foreground="#6B7B8D"/>
                        <Border BorderBrush="#D0D7DE" BorderThickness="0,0,0,1"
                                Margin="0,20,0,0" Padding="0,0,0,3">
                            <TextBlock Text="подпись                    дата" FontSize="10"
                                       Foreground="#CBD5E0" HorizontalAlignment="Right"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Водитель (принял задание):" FontSize="11" Foreground="#6B7B8D"/>
                        <Border BorderBrush="#D0D7DE" BorderThickness="0,0,0,1"
                                Margin="0,20,0,0" Padding="0,0,0,3">
                            <TextBlock Text="подпись                    дата" FontSize="10"
                                       Foreground="#CBD5E0" HorizontalAlignment="Right"/>
                        </Border>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- Нижние кнопки -->
        <Border Grid.Row="2" Background="#F7F9FC" BorderBrush="#D0D7DE"
                BorderThickness="0,1,0,0" Padding="16,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                           FontSize="11" Foreground="#6B7B8D"
                           Text="Экспорт в Word (RTF) откроется в Microsoft Word автоматически"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Сохранить в Word / RTF" Click="SaveToWord_Click"
                            Height="30" Padding="14,0" FontSize="12" Margin="0,0,8,0"
                            Background="#1E3A5F" Foreground="White" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        CornerRadius="3" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#2D4F72"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="Печать" Click="Print_Click"
                            Height="30" Padding="14,0" FontSize="12" Margin="0,0,8,0"
                            Background="White" BorderBrush="#CBD5E0" BorderThickness="1" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="3" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#EBF4FF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="Закрыть" IsCancel="True"
                            Height="30" Padding="14,0" FontSize="12"
                            Background="White" BorderBrush="#CBD5E0" BorderThickness="1" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="3" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
