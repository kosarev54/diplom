<Window x:Class="DispatcherARM.UI.Views.Dialogs.OrderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Заказ" Width="580" Height="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource MaterialDesign.Brush.Background}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock x:Name="DialogTitle" Text="Новый заказ"
                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                       Margin="0,0,0,20"/>

            <!-- Клиент -->
            <TextBox x:Name="ClientNameBox"
                     materialDesign:HintAssist.Hint="Имя / организация клиента *"
                     materialDesign:HintAssist.IsFloating="True"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Margin="0,0,0,12"/>
            <TextBox x:Name="ClientPhoneBox"
                     materialDesign:HintAssist.Hint="Телефон клиента"
                     materialDesign:HintAssist.IsFloating="True"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Margin="0,0,0,12"/>

            <!-- Адрес -->
            <TextBox x:Name="AddressBox"
                     materialDesign:HintAssist.Hint="Адрес доставки *"
                     materialDesign:HintAssist.IsFloating="True"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Margin="0,0,0,12"/>

            <!-- Координаты -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBox x:Name="LatitudeBox" Width="200"
                         materialDesign:HintAssist.Hint="Широта (55.7558)"
                         materialDesign:HintAssist.IsFloating="True"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,12,0"/>
                <TextBox x:Name="LongitudeBox" Width="200"
                         materialDesign:HintAssist.Hint="Долгота (37.6173)"
                         materialDesign:HintAssist.IsFloating="True"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
            </StackPanel>
            <TextBlock Foreground="Gray" FontSize="11" Margin="2,0,0,12"
                       Text="📍 Координаты нужны для автоматического расчёта даты доставки"/>

            <!-- Груз -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBox x:Name="WeightBox" Width="190"
                         materialDesign:HintAssist.Hint="Вес (кг)"
                         materialDesign:HintAssist.IsFloating="True"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,12,0"/>
                <TextBox x:Name="VolumeBox" Width="190"
                         materialDesign:HintAssist.Hint="Объём (м³)"
                         materialDesign:HintAssist.IsFloating="True"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
            </StackPanel>

            <!-- Цены -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBox x:Name="DeliveryPriceBox" Width="190"
                         materialDesign:HintAssist.Hint="Цена доставки (₽)"
                         materialDesign:HintAssist.IsFloating="True"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,12,0"/>
                <TextBox x:Name="CashOnDeliveryBox" Width="190"
                         materialDesign:HintAssist.Hint="Наложенный платёж (₽)"
                         materialDesign:HintAssist.IsFloating="True"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
            </StackPanel>

            <!-- Приоритет -->
            <ComboBox x:Name="PriorityBox"
                      materialDesign:HintAssist.Hint="Приоритет"
                      materialDesign:HintAssist.IsFloating="True"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      SelectedIndex="1" Margin="0,0,0,12">
                <ComboBoxItem Content="🟢 Низкий"/>
                <ComboBoxItem Content="🟡 Обычный"/>
                <ComboBoxItem Content="🟠 Высокий"/>
                <ComboBoxItem Content="🔴 Срочный"/>
            </ComboBox>

            <!-- Дата доставки + авторасчёт -->
            <DatePicker x:Name="DeliveryDatePicker"
                        materialDesign:HintAssist.Hint="Дата доставки"
                        materialDesign:HintAssist.IsFloating="True"
                        Margin="0,0,0,8"/>

            <Border Background="#EFF6FF" CornerRadius="8" Padding="12,10" Margin="0,0,0,12"
                    BorderBrush="#BFDBFE" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Content="🗓 Рассчитать дату автоматически"
                                Click="CalcDate_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                FontSize="12" Padding="12,4" Margin="0,0,10,0"/>
                        <TextBlock Text="по координатам + приоритет"
                                   VerticalAlignment="Center"
                                   Foreground="Gray" FontSize="11"/>
                    </StackPanel>
                    <TextBlock x:Name="DateHintText"
                               Foreground="#3F51B5" FontSize="12" TextWrapping="Wrap"
                               Text="Введите координаты и нажмите кнопку для автоматического расчёта даты"/>
                </StackPanel>
            </Border>

            <!-- Примечания -->
            <TextBox x:Name="NotesBox"
                     materialDesign:HintAssist.Hint="Примечания к заказу"
                     materialDesign:HintAssist.IsFloating="True"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     AcceptsReturn="True" Height="60" TextWrapping="Wrap"
                     Margin="0,0,0,20"/>

            <!-- Ошибка -->
            <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap"
                       Margin="0,0,0,12" Visibility="Collapsed"/>

            <!-- Кнопки -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" IsCancel="True"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Margin="0,0,8,0"/>
                <Button x:Name="SaveButton" Content="💾 Сохранить"
                        Click="SaveButton_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
